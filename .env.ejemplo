# Copia este fichero a .env y rellena la clave.
# El .env NO se sube a ningún sitio: es tuyo y lleva una credencial dentro.

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# DOS MODELOS, SEGÚN LO QUE HAGA FALTA EN CADA FASE.
#
# No todas las llamadas deciden algo. Listar los imprescindibles de una ciudad o
# traducir un horario es mecánica, y la mecánica no mejora por pensarla más
# despacio; elegir por dónde se entra a un país sí. Qué fase usa cuál se decide
# en la pantalla del orquestador (parámetros "modelo_<fase>"), que guarda
# "criterio" o "rapido" y nunca un nombre de modelo: así una versión nueva se
# cambia aquí y en ningún sitio más.

# El listo, para decidir.
MODELO_CRITERIO=claude-sonnet-5

# El rápido y barato, para la mecánica.
MODELO_RAPIDO=claude-haiku-4-5

# Respaldo de compatibilidad: si faltan las dos de arriba, se usa esta para
# todo. Una instalación nueva no la necesita.
# MODELO_IA=claude-haiku-4-5
