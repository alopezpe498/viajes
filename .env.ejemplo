# Copia este fichero a .env y rellena la clave.
# El .env NO se sube a ningún sitio: es tuyo y lleva una credencial dentro.

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Por defecto claude-haiku-4-5, que es el más rápido y barato
# y va de sobra para listar los imprescindibles de un país.
# Otras opciones: claude-sonnet-5, claude-opus-5
MODELO_IA=claude-haiku-4-5
