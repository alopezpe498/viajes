<%
/**
 * EL CEREBRO DEL ORQUESTADOR: lo que se le dice a la IA en cada fase.
 *
 * Un editor por fase. El worker lee SIEMPRE de la tabla que hay detrás de esta
 * pantalla, nunca de una constante en el código: si el prompt viviera en dos
 * sitios, el que se edita aquí no sería el que se usa, y descubrirlo cuesta una
 * tarde.
 *
 * Los prompts de hoy son marcadores de posición. Llegarán con cada fase.
 *
 * Espera: prompts.
 */
const cabezaExtra = '<link rel="stylesheet" href="/css/orquestador.css">';
const pieExtra = '<script src="/js/orquestador.js" defer></script>';

/** "2026-09-09 17:04:11" -> "9 sep, 17:04" */
const MESES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function cuando(iso) {
  if (!iso) return null;
  const [f, h] = String(iso).split(' ');
  const [, m, d] = f.split('-').map(Number);
  return `${d} ${MESES[m - 1]}${h ? ', ' + h.slice(0, 5) : ''}`;
}
%>
<%- include('parciales/cabecera', {
      viaje: null,
      pasoActual: null,
      titulo: 'Cerebro del orquestador',
      extraCabeza: cabezaExtra,
    }) %>

<main class="envoltorio envoltorio--simple">
  <div class="contenido orquestador">

    <header class="ruta-cabecera">
      <p class="ruta-cabecera__miga"><a href="/">Mis viajes</a> / Ajustes</p>
      <h1 class="orq__titulo">
        <i class="ti ti-brain" aria-hidden="true"></i> Cerebro del orquestador
      </h1>
      <p class="orq__bajada">
        Lo que se le pide a la IA en cada fase. Se usa esto tal cual, así que lo
        que cambies aquí cambia cómo monta el viaje.
      </p>
    </header>

    <p class="orq-aviso" data-aviso-prompt hidden></p>

    <% prompts.forEach(p => { %>
      <section class="orq-prompt <%= p.esDeFabrica ? '' : 'orq-prompt--tocado' %>"
               data-prompt="<%= p.fase %>">
        <header class="orq-prompt__cabecera">
          <h2 class="orq-prompt__nombre">
            <i class="ti <%= p.icono %>" aria-hidden="true"></i> <%= p.etiqueta %>
          </h2>
          <span class="orq-prompt__cuando">
            <% if (p.esDeFabrica) { %>
              Como vino de fábrica
            <% } else if (p.actualizadoEn) { %>
              Editado el <%= cuando(p.actualizadoEn) %>
            <% } else { %>
              Editado
            <% } %>
          </span>
        </header>

        <p class="orq-prompt__explica"><%= p.explica %></p>

        <textarea class="orq-prompt__texto" data-texto rows="6"
                  aria-label="Prompt de <%= p.etiqueta %>"><%= p.texto %></textarea>

        <div class="orq-prompt__acciones">
          <button class="boton boton--primario" type="button" data-guardar>
            <i class="ti ti-device-floppy" aria-hidden="true"></i> Guardar
          </button>
          <button class="boton boton--secundario" type="button" data-restaurar-prompt
                  <%= p.esDeFabrica ? 'hidden' : '' %>>
            <i class="ti ti-rotate" aria-hidden="true"></i> Restaurar de fábrica
          </button>
        </div>
      </section>
    <% }) %>

    <div class="orq-pie">
      <a class="boton boton--secundario" href="/orquestador/parametros">
        <i class="ti ti-adjustments" aria-hidden="true"></i> Parámetros del orquestador
      </a>
    </div>
  </div>
</main>

<%- include('parciales/pie', { extraPie: pieExtra }) %>
