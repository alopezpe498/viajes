<%
/**
 * EL ORQUESTADOR: una pantalla, una sección por fase.
 *
 * Antes esto eran dos pantallas —los números por un lado, los prompts por otro—
 * y para entender qué hace una fase había que abrirlas las dos y juntarlas
 * mentalmente. Ahora cada fase enseña lo suyo: primero con qué números decide y
 * debajo qué se le dice a la IA.
 *
 * Las secciones van en el orden en que se ejecutan las fases, con «General»
 * delante para lo que usan varias a la vez.
 *
 * Espera: secciones.
 */
const cabezaExtra = '<link rel="stylesheet" href="/css/orquestador.css">';
const pieExtra = '<script src="/js/orquestador.js" defer></script>';

/** "2026-09-09 17:04:11" -> "9 sep, 17:04" */
const MESES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function cuando(iso) {
  if (!iso) return null;
  const [f, h] = String(iso).split(' ');
  const [, m, d] = f.split('-').map(Number);
  return `${d} ${MESES[m - 1]}${h ? ', ' + h.slice(0, 5) : ''}`;
}
%>
<%- include('parciales/cabecera', {
      viaje: null,
      pasoActual: null,
      titulo: 'Orquestador',
      extraCabeza: cabezaExtra,
    }) %>

<main class="envoltorio envoltorio--simple">
  <div class="contenido orquestador">

    <header class="ruta-cabecera">
      <p class="ruta-cabecera__miga"><a href="/">Mis viajes</a> / Ajustes</p>
      <h1 class="orq__titulo">
        <i class="ti ti-adjustments" aria-hidden="true"></i> Orquestador
      </h1>
      <p class="orq__bajada">
        Con qué números decide y qué se le dice a la IA en cada fase. Se usa esto
        tal cual, así que lo que cambies aquí cambia cómo monta los viajes.
      </p>
    </header>

    <p class="orq-aviso" data-aviso hidden></p>

    <%# Un índice para no tener que bajar a buscar. Con siete secciones y prompts
        largos, la pantalla es larga: esto la vuelve navegable. %>
    <nav class="orq-indice" aria-label="Secciones">
      <a class="orq-indice__enlace" href="#seccion-instalacion">
        <i class="ti ti-key" aria-hidden="true"></i> Instalación
      </a>
      <% secciones.forEach(s => { %>
        <a class="orq-indice__enlace" href="#seccion-<%= s.clave %>">
          <i class="ti <%= s.icono %>" aria-hidden="true"></i> <%= s.etiqueta %>
        </a>
      <% }) %>
    </nav>

    <%# ======================= INSTALACIÓN =======================
        Las claves y los ajustes del servidor. Van primeras porque sin ellas no
        funciona nada de lo de abajo, y con su propio render: los parámetros de
        las fases son números con valor de fábrica y un botón de restaurar, y una
        credencial no es ninguna de esas tres cosas.

        LA CLAVE NUNCA VIAJA A ESTA PÁGINA. De los secretos solo llega `hay` y
        los cuatro últimos caracteres. Mirar el código de la página no enseña
        ninguna clave. %>
    <section class="orq-seccion" id="seccion-instalacion">
      <header class="orq-seccion__cabecera">
        <h2 class="orq-seccion__titulo">
          <i class="ti ti-key" aria-hidden="true"></i> Instalación
        </h2>
        <p class="orq-seccion__explica">
          Las claves de las APIs y los ajustes del servidor. Lo que guardes aquí manda
          sobre el fichero <code>.env</code>; lo que dejes sin guardar se sigue leyendo
          de él. El <code>.env</code> no se toca nunca.
        </p>
      </header>

      <ul class="orq-ajustes">
        <% instalacion.forEach(a => { %>
          <li class="orq-ajuste" data-ajuste="<%= a.clave %>" data-secreto="<%= a.secreto ? '1' : '' %>">
            <div class="orq-ajuste__texto">
              <label class="orq-parametro__nombre" for="a-<%= a.clave %>"><%= a.etiqueta %></label>
              <code class="orq-parametro__clave"><%= a.clave %></code>
              <p class="orq-ajuste__explica"><%= a.explica %></p>
            </div>

            <div class="orq-ajuste__control">
              <%# --- De dónde sale lo que se está usando ahora mismo --- %>
              <span class="orq-origen orq-origen--<%= a.origen %>" data-origen>
                <% if (a.origen === 'guardado') { %>Guardado aquí<% } %>
                <% if (a.origen === 'entorno') { %>Del .env<% } %>
                <% if (a.origen === 'fabrica') { %>De fábrica<% } %>
                <% if (a.origen === 'sin-configurar') { %>Sin configurar<% } %>
              </span>

              <div class="orq-ajuste__fila">
                <% if (a.secreto) { %>
                  <%# EL CAMPO NACE BLOQUEADO CON PUNTITOS si ya hay clave. Para
                      cambiarla hay que pulsar Reemplazar: así no se borra de un
                      clic distraído algo que no se puede volver a ver. %>
                  <input type="password" id="a-<%= a.clave %>" data-valor
                         autocomplete="off" spellcheck="false"
                         placeholder="<%= a.hay ? '' : 'Pega aquí la clave' %>"
                         value="<%= a.hay ? '••••••••••••' : '' %>"
                         <%= a.hay ? 'readonly' : '' %>
                         aria-label="<%= a.etiqueta %>">
                  <% if (a.pista) { %>
                    <span class="orq-ajuste__pista" data-pista>acaba en <%= a.pista %></span>
                  <% } %>
                <% } else { %>
                  <input type="text" id="a-<%= a.clave %>" data-valor
                         autocomplete="off" spellcheck="false"
                         placeholder="<%= a.fabrica || '(vacío)' %>"
                         value="<%= a.valor || '' %>"
                         aria-label="<%= a.etiqueta %>">
                <% } %>
              </div>

              <div class="orq-ajuste__botones">
                <% if (a.secreto) { %>
                  <button type="button" class="orq-ajuste__accion" data-reemplazar
                          <%= a.hay ? '' : 'hidden' %>>
                    <i class="ti ti-pencil" aria-hidden="true"></i> Reemplazar
                  </button>
                  <button type="button" class="orq-ajuste__accion" data-guardar-ajuste
                          <%= a.hay ? 'hidden' : '' %>>
                    <i class="ti ti-device-floppy" aria-hidden="true"></i> Guardar
                  </button>
                <% } else { %>
                  <button type="button" class="orq-ajuste__accion" data-guardar-ajuste>
                    <i class="ti ti-device-floppy" aria-hidden="true"></i> Guardar
                  </button>
                <% } %>

                <% if (a.sePuedeProbar) { %>
                  <button type="button" class="orq-ajuste__accion" data-probar>
                    <i class="ti ti-plug-connected" aria-hidden="true"></i> Probar
                  </button>
                <% } %>

                <%# Quitar solo tiene sentido si hay algo guardado AQUÍ: lo que
                    viene del .env no se quita desde una pantalla. %>
                <button type="button" class="orq-ajuste__accion orq-ajuste__quitar" data-quitar
                        <%= a.origen === 'guardado' ? '' : 'hidden' %>>
                  <i class="ti ti-trash" aria-hidden="true"></i> Quitar
                </button>
              </div>

              <p class="orq-ajuste__resultado" data-resultado hidden></p>
            </div>
          </li>
        <% }) %>

        <%# ---------- LA FILA QUE PARECE UNA PREFERENCIA Y ES UN BOTÓN ----------

            Tiene la misma pinta que las de arriba —etiqueta, explicación y algo
            a la derecha— porque es donde uno va a buscarla. Pero no hay nada que
            escribir: lo único que se puede hacer con un tour es volver a verlo.

            Va al final de la sección a propósito: lo de arriba son claves sin
            las cuales la aplicación no funciona, y esto es una comodidad. %>
        <li class="orq-ajuste" data-ajuste="tour">
          <div class="orq-ajuste__texto">
            <span class="orq-parametro__nombre">Tour de bienvenida</span>
            <p class="orq-ajuste__explica">
              Las burbujas que señalan las partes de la aplicación la primera vez que
              se pisa cada pantalla. Se lanza solo una vez; desde aquí se vuelve a ver
              entero, desde la primera parada.
            </p>
          </div>

          <div class="orq-ajuste__control">
            <span class="orq-origen orq-origen--<%= tourVisto ? 'guardado' : 'fabrica' %>">
              <%= tourVisto ? 'Ya visto' : 'Sin ver' %>
            </span>
            <div class="orq-ajuste__fila">
              <div class="orq-ajuste__botones">
                <button type="button" class="orq-ajuste__accion" id="tour-relanzar">
                  <i class="ti ti-player-play" aria-hidden="true"></i> Ver el tour de bienvenida
                </button>
              </div>
            </div>
            <p class="orq-ajuste__resultado" id="tour-relanzar-resultado" hidden></p>
          </div>
        </li>
      </ul>

      <p class="orq-ajuste__nota">
        <i class="ti ti-info-circle" aria-hidden="true"></i>
        El <strong>puerto</strong> no se ajusta aquí: se lee del <code>.env</code> al
        arrancar, y cambiarlo desde una página serviría de poco —haría falta reiniciar,
        y hasta entonces esta pantalla se seguiría sirviendo por el puerto viejo—.
      </p>
    </section>

    <% secciones.forEach(s => { %>
      <section class="orq-seccion" id="seccion-<%= s.clave %>">
        <header class="orq-seccion__cabecera">
          <h2 class="orq-seccion__titulo">
            <i class="ti <%= s.icono %>" aria-hidden="true"></i> <%= s.etiqueta %>
          </h2>
          <p class="orq-seccion__explica"><%= s.explica %></p>
        </header>

        <%# --- LOS NÚMEROS --------------------------------------------- %>
        <% if (s.parametros.length) { %>
          <ul class="orq-parametros">
            <% s.parametros.forEach(p => { %>
              <li class="orq-parametro <%= p.esDeFabrica ? '' : 'orq-parametro--tocado' %>"
                  data-parametro="<%= p.clave %>">
                <div class="orq-parametro__texto">
                  <label class="orq-parametro__nombre" for="p-<%= p.clave %>">
                    <%= p.descripcion %>

                    <%# EL SÍMBOLO VA DENTRO DEL LABEL, PEGADO AL TEXTO.
                        Puesto fuera se separaba del nombre al hacer wrap la fila
                        —el `li` es flex con `flex-wrap`— y quedaba un interrogante
                        huérfano a media altura. Aquí viaja con su frase siempre.

                        No es un `<label>` anidado: es un botón dentro del label,
                        y por eso lleva su propio `type="button"` y para la
                        propagación en el JS, para que pulsarlo no ponga el foco
                        en el input como haría un clic en la etiqueta. %>
                    <button class="orq-parametro__ayuda" type="button" data-ayuda
                            aria-label="Qué es «<%= p.descripcion %>»"
                            title="Qué es y para qué sirve"
                            data-clave="<%= p.clave %>"
                            data-titulo="<%= p.descripcion %>"
                            data-unidad="<%= p.unidad || '' %>"
                            data-fabrica="<%= p.valor_fabrica %>"
                            data-texto="<%= p.ayuda || '' %>"
                            data-ejemplo="<%= p.ejemplo || '' %>">
                      <i class="ti ti-help-circle" aria-hidden="true"></i>
                    </button>
                  </label>
                  <code class="orq-parametro__clave"><%= p.clave %></code>
                </div>

                <div class="orq-parametro__control">
                  <input type="number" id="p-<%= p.clave %>" min="0" step="1"
                         value="<%= p.valor %>" data-valor
                         aria-label="<%= p.descripcion %>">
                  <span class="orq-parametro__unidad"><%= p.unidad || '' %></span>

                  <%# El botón solo aparece si hay algo que restaurar: enseñarlo
                      siempre invita a pulsarlo para no cambiar nada. %>
                  <button class="orq-parametro__restaurar" type="button" data-restaurar
                          title="Volver a <%= p.valor_fabrica %>"
                          <%= p.esDeFabrica ? 'hidden' : '' %>>
                    <i class="ti ti-rotate" aria-hidden="true"></i>
                    <span>De fábrica: <%= p.valor_fabrica %></span>
                  </button>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="orq-seccion__sin">Esta fase no tiene números que ajustar todavía.</p>
        <% } %>

        <%# --- Y LO QUE SE LE DICE A LA IA ------------------------------ %>
        <% if (s.prompt) { %>
          <div class="orq-prompt <%= s.prompt.esDeFabrica ? '' : 'orq-prompt--tocado' %>"
               data-prompt="<%= s.prompt.fase %>">
            <div class="orq-prompt__cabecera">
              <h3 class="orq-prompt__nombre">
                <i class="ti ti-brain" aria-hidden="true"></i> Lo que se le pide a la IA
              </h3>
              <span class="orq-prompt__cuando">
                <% if (s.prompt.esDeFabrica) { %>
                  Como vino de fábrica
                <% } else if (s.prompt.actualizadoEn) { %>
                  Editado el <%= cuando(s.prompt.actualizadoEn) %>
                <% } else { %>
                  Editado
                <% } %>
              </span>
            </div>

            <textarea class="orq-prompt__texto" data-texto rows="10"
                      aria-label="Prompt de <%= s.etiqueta %>"><%= s.prompt.texto %></textarea>

            <div class="orq-prompt__acciones">
              <button class="boton boton--primario" type="button" data-guardar>
                <i class="ti ti-device-floppy" aria-hidden="true"></i> Guardar
              </button>
              <button class="boton boton--secundario" type="button" data-restaurar-prompt
                      <%= s.prompt.esDeFabrica ? 'hidden' : '' %>>
                <i class="ti ti-rotate" aria-hidden="true"></i> Restaurar de fábrica
              </button>
            </div>
          </div>
        <% } %>
      </section>
    <% }) %>

    <div class="orq-pie">
      <a class="boton boton--secundario" href="/">
        <i class="ti ti-chevron-left" aria-hidden="true"></i> Volver a mis viajes
      </a>
    </div>
  </div>
</main>

<%# ===========================================================================
    LA VENTANA DE AYUDA
    ---------------------------------------------------------------------------
    UNA SOLA PARA LAS 116, y se rellena al abrirla desde los `data-` del botón
    que la llama. Pintar un diálogo por parámetro serían 116 bloques en el HTML
    de una pantalla que ya es larga, y todos ocultos menos uno.

    `<dialog>` nativo y no un div a mano: trae el fondo, el foco atrapado dentro,
    el cierre con Escape y la vuelta del foco al botón sin una línea de JS. Es la
    primera de la app —no había ninguna— así que queda como el patrón para las
    que vengan.
    =========================================================================== %>
<dialog class="orq-ayuda" id="ayuda-parametro">
  <form method="dialog" class="orq-ayuda__cerrar-form">
    <button class="orq-ayuda__cerrar" type="submit" aria-label="Cerrar">
      <i class="ti ti-x" aria-hidden="true"></i>
    </button>
  </form>

  <h3 class="orq-ayuda__titulo" id="ayuda-titulo"></h3>
  <code class="orq-ayuda__clave" id="ayuda-clave"></code>

  <div class="orq-ayuda__cuerpo">
    <p class="orq-ayuda__texto" id="ayuda-texto"></p>

    <div class="orq-ayuda__ejemplo" id="ayuda-ejemplo-caja" hidden>
      <span class="orq-ayuda__etiqueta">Un ejemplo</span>
      <p id="ayuda-ejemplo"></p>
    </div>

    <%# EL HUECO HONESTO. 116 parámetros no se explican de un tirón sin
        inventarse la mitad, así que los que aún no tienen texto lo dicen en vez
        de enseñar un relleno que suene bien. %>
    <p class="orq-ayuda__pendiente" id="ayuda-pendiente" hidden>
      Este número todavía no está explicado. Prefiero dejar el hueco a escribir
      algo que suene bien y no sea exacto: su nombre en clave está aquí arriba y
      en el código se ve qué hace.
    </p>
  </div>

  <p class="orq-ayuda__pie">
    <span>De fábrica: <strong id="ayuda-fabrica"></strong> <span id="ayuda-unidad"></span></span>
  </p>
</dialog>

<script>
  // LA VENTANA DE AYUDA DE CADA NÚMERO.
  //
  // Un solo listener en el documento en vez de uno por botón: son 116 y la lista
  // no cambia, pero delegar cuesta lo mismo de escribir y no hay que acordarse
  // de enganchar nada si mañana se pintan por JS.
  const dlgAyuda = document.getElementById('ayuda-parametro');

  document.addEventListener('click', (e) => {
    const boton = e.target.closest('[data-ayuda]');
    if (!boton || !dlgAyuda) return;

    // El botón vive DENTRO del `<label>`: sin esto, el clic llega a la etiqueta,
    // el navegador enfoca el input del parámetro y la ventana se abre con el
    // número ya seleccionado detrás. Se ve raro y se toca sin querer.
    e.preventDefault();
    e.stopPropagation();

    const texto = boton.dataset.texto?.trim();
    const ejemplo = boton.dataset.ejemplo?.trim();

    document.getElementById('ayuda-titulo').textContent = boton.dataset.titulo || '';
    document.getElementById('ayuda-clave').textContent = boton.dataset.clave || '';
    document.getElementById('ayuda-fabrica').textContent = boton.dataset.fabrica || '—';
    document.getElementById('ayuda-unidad').textContent = boton.dataset.unidad || '';

    document.getElementById('ayuda-texto').textContent = texto || '';
    document.getElementById('ayuda-texto').hidden = !texto;
    document.getElementById('ayuda-ejemplo').textContent = ejemplo || '';
    document.getElementById('ayuda-ejemplo-caja').hidden = !ejemplo;
    document.getElementById('ayuda-pendiente').hidden = Boolean(texto);

    dlgAyuda.showModal();
  });

  // Pulsar en el fondo cierra, que es lo que todo el mundo intenta. `<dialog>`
  // no lo trae: el clic en el backdrop llega al propio diálogo, así que se mira
  // si cayó fuera de su caja.
  dlgAyuda?.addEventListener('click', (e) => {
    if (e.target !== dlgAyuda) return;
    const c = dlgAyuda.getBoundingClientRect();
    const fuera =
      e.clientX < c.left || e.clientX > c.right || e.clientY < c.top || e.clientY > c.bottom;
    if (fuera) dlgAyuda.close();
  });
</script>

<script>
  // LA FILA CAMUFLADA. Borra los dos flags y devuelve a la portada.
  //
  // No hace falta llevar a ninguna pantalla concreta: con los flags limpios, el
  // tour vuelve a comportarse como el primer día, y cada pantalla suelta su
  // tramo en cuanto se pisa. Mandar a la fuerza a la configuración de un viaje
  // que a lo mejor ya está terminado sería peor que dejar que salga solo.
  document.getElementById('tour-relanzar')?.addEventListener('click', async (e) => {
    const boton = e.currentTarget;
    const aviso = document.getElementById('tour-relanzar-resultado');
    boton.disabled = true;
    try {
      await fetch('/api/tour/reiniciar', { method: 'POST' });
      location.href = '/';
    } catch {
      boton.disabled = false;
      aviso.textContent = 'No he podido reiniciarlo. Inténtalo otra vez.';
      aviso.hidden = false;
    }
  });
</script>
<%- include('parciales/pie', { extraPie: pieExtra }) %>
