<%
/**
 * LA ETAPA: el subproyecto de una parada.
 *
 * Tres pestañas con el mismo patrón que la ficha de ciudad, pero cada una
 * conectada a las cajas que ya existían: los sitios del catálogo y Civitatis en
 * "Qué ver", el panel de Booking en "Dónde dormir" y los tramos en "Cómo
 * llegar". Aquí no se reinventa ninguna, se enchufan a la etapa.
 *
 * Espera: etapa, viaje, punto, confirmada, anterior, siguiente, posicion,
 *         total, queVer, dormir, tramos, tiposTransporte, preparando, orden.
 */
// El mapa de la parada usa la MISMA base que el de descubrir: Leaflet, el
// puente con Google y el módulo de teselas compartido. Mismas versiones a
// propósito: dos Leaflets distintos en la misma app solo dan problemas.
const LEAFLET = '1.9.4';
const MUTANT = '0.14.1';

const cabezaExtra =
  `<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/${LEAFLET}/leaflet.min.css">`;

const pieExtra =
  `<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/${LEAFLET}/leaflet.min.js"></script>` +
  `<script src="https://cdn.jsdelivr.net/npm/leaflet.gridlayer.googlemutant@${MUTANT}/dist/Leaflet.GoogleMutant.min.js"></script>` +
  '<script src="/js/mapa-teselas.js"></script>' +
  '<script src="/js/etapa.js"></script>' +
  '<script src="/js/adjuntos.js"></script>' +
  '<script src="/js/mapa-etapa.js"></script>';

const MESES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const dia = (iso) => {
  if (!iso) return null;
  const [, m, d] = iso.split('-').map(Number);
  return `${d} ${MESES[m - 1]}`;
};
const noches = (n) => `${n} ${n === 1 ? 'noche' : 'noches'}`;
const rango = etapa.fecha_inicio
  ? `${dia(etapa.fecha_inicio)} → ${dia(etapa.fecha_fin)} · ${noches(etapa.noches)}`
  : null;

// Insignias de los hoteles: el más barato y el mejor valorado por nota
// ponderada. Mismo criterio que el paso 6, que para eso es la misma caja.
let idBarato = null;
let idMejor = null;
if (dormir.hoteles?.length) {
  const conPrecio = dormir.hoteles.filter((h) => h.precio != null);
  if (conPrecio.length) idBarato = conPrecio.reduce((a, b) => (b.precio < a.precio ? b : a)).id;
  const conNota = dormir.hoteles.filter((h) => h.ponderada != null);
  if (conNota.length) idMejor = conNota.reduce((a, b) => (b.ponderada > a.ponderada ? b : a)).id;
}

const ORDENES = [
  { valor: 'recomendados', etiqueta: 'Recomendados', icono: 'ti-sparkles' },
  { valor: 'precio',       etiqueta: 'Precio',       icono: 'ti-coin' },
  { valor: 'nota',         etiqueta: 'Nota',         icono: 'ti-star' },
];

const ICONO_TIPO = {
  tren: 'ti-train', bus: 'ti-bus', coche: 'ti-car', ferry: 'ti-ship', vuelo: 'ti-plane',
};
%>
<%- include('parciales/cabecera', {
      viaje: null, pasoActual: null, titulo: etapa.nombre_ciudad, extraCabeza: cabezaExtra
    }) %>

<main class="envoltorio envoltorio--simple">
  <div class="contenido contenido--etapa"
       data-etapa="<%= etapa.id %>"
       <%# El sondeo se enciende si CUALQUIER cosa de esta pantalla está en
           marcha. Los vuelos faltaban aquí, y por eso su "Buscando en Kayak…"
           se quedaba colgado aunque el trabajo hubiera terminado bien. %>
       data-trabajando="<%= preparando.trabajando
             || dormir.estado === 'buscando'
             || moverse.buscando
             || traslados.calculando
             || comer.buscando
             || tramos.some((t) => t.resultados.estado === 'buscando')
             || tramos.some((t) => t.medios?.buscando) ? '1' : '' %>">

    <%# ======================= CABECERA ======================= %>
    <header class="ruta-cabecera">
      <p class="ruta-cabecera__miga">
        <a href="/">Mis viajes</a> /
        <a href="/viaje/<%= viaje.id %>/ruta">Mi ruta</a> /
        <%= etapa.nombre_ciudad %>
      </p>

      <div class="etapa-titular">
        <h1 class="ruta-cabecera__titulo">
          <%= etapa.nombre_ciudad %>
          <% if (confirmada && posicion) { %>
            <span class="chip-ambito">Etapa <%= posicion %></span>
          <% } else { %>
            <span class="chip-ambito chip-ambito--pendiente">
              <i class="ti ti-alert-triangle" aria-hidden="true"></i> Sin confirmar
            </span>
          <% } %>
        </h1>

        <span class="etapa-acciones">
          <a class="boton-discreto" href="/viaje/<%= viaje.id %>/lienzo?etapa=<%= etapa.id %>">
            <i class="ti ti-layout-board" aria-hidden="true"></i> Ver el lienzo de esta etapa
          </a>
          <a class="boton-discreto" href="/viaje/<%= viaje.id %>/ruta">
            <i class="ti ti-arrow-left" aria-hidden="true"></i> Volver a la ruta
          </a>
        </span>
      </div>

      <% if (rango) { %>
        <p class="etapa-fechas"><i class="ti ti-calendar" aria-hidden="true"></i> <%= rango %></p>
      <% } %>
    </header>

    <% if (!confirmada) { %>
      <div class="franja">
        <i class="ti ti-info-circle" aria-hidden="true"></i>
        <span>Confírmala en la ruta para tener fechas y poder cotizar hotel.</span>
        <a class="boton-discreto" href="/viaje/<%= viaje.id %>/ruta">Ir a la ruta</a>
      </div>
    <% } %>

    <%# ======================= NOTAS ======================= %>
    <details class="notas" <%= etapa.notas ? 'open' : '' %>>
      <summary class="notas__resumen">
        <i class="ti ti-plus notas__mas" aria-hidden="true"></i>
        <i class="ti ti-note notas__icono" aria-hidden="true"></i>
        Notas de la etapa
        <span class="notas__estado" id="notas-estado"></span>
      </summary>
      <textarea class="notas__campo" id="notas-campo" rows="3"
                placeholder="Lo que no quieras olvidar de esta parada: reservas, horarios, avisos…"
                data-url="/etapa/<%= etapa.id %>/notas"><%= etapa.notas || '' %></textarea>
    </details>

    <%# ======================= PESTAÑAS ======================= %>
    <%# LA PESTAÑA ABIERTA LA MANDA EL SERVIDOR.
        Aquí estaba clavada "Qué ver" con `pestana--activa` a pelo, y como la
        pantalla se recarga entera cada vez que termina una búsqueda, cada
        recarga te devolvía a "Qué ver" antes de que el JS repusiera la tuya.
        Ahora viene decidida en `vista` y la pantalla nace bien. %>
    <div class="pestanas" role="tablist" id="pestanas">
      <button class="pestana <%= vista.pestana === 'ver' ? 'pestana--activa' : '' %>"
              type="button" role="tab"
              aria-selected="<%= vista.pestana === 'ver' %>" data-panel="panel-ver" data-ancla="ver">
        Qué ver <span class="pestana__n"><%= queVer.apuntados %></span>
      </button>
      <button class="pestana <%= vista.pestana === 'dormir' ? 'pestana--activa' : '' %>"
              type="button" role="tab"
              aria-selected="<%= vista.pestana === 'dormir' %>" data-panel="panel-dormir" data-ancla="dormir">Dónde dormir</button>
      <button class="pestana <%= vista.pestana === 'llegar' ? 'pestana--activa' : '' %>"
              type="button" role="tab"
              aria-selected="<%= vista.pestana === 'llegar' %>" data-panel="panel-llegar" data-ancla="llegar">Cómo llegar</button>
      <button class="pestana <%= vista.pestana === 'mapa' ? 'pestana--activa' : '' %>"
              type="button" role="tab"
              aria-selected="<%= vista.pestana === 'mapa' %>" data-panel="panel-mapa" data-ancla="mapa">
        Mapa <span class="pestana__n"><%= mapaEtapa.elementos.length %></span>
      </button>
    </div>

    <%# ---------------------- 1) QUÉ VER ---------------------- %>
    <section class="panel" id="panel-ver" role="tabpanel" <%= vista.pestana === 'ver' ? '' : 'hidden' %>>
      <%# LA ETAPA NACE LLENA.
          Si la ciudad no tiene nada investigado, al entrar se lanzan solas las
          dos búsquedas (sitios y excursiones) y esto cuenta lo que está
          pasando. No hay nada que pulsar: entrar en Sevilla es querer Sevilla. %>
      <% if (preparando.trabajando) { %>
        <%# El sondeo lo lleva el general de la pantalla, que ya pregunta por
            todo de una vez. Este bloque solo pone el sitio donde escribir. %>
        <div class="franja franja--trabajando" id="preparando-etapa">
          <span class="rueda" aria-hidden="true"></span>
          <span id="preparando-mensaje"><%= preparando.mensaje %></span>
          <span class="franja__pista secundario">Se recarga sola cuando esté.</span>
        </div>
      <% } else if (preparando.mensaje_error) { %>
        <div class="aviso aviso--alerta">
          <i class="ti ti-alert-octagon" aria-hidden="true"></i>
          <div>
            <div class="aviso__titulo">No se pudo preparar <%= etapa.nombre_ciudad %></div>
            <p class="aviso__texto"><%= preparando.mensaje_error %></p>
            <form method="POST" action="/api/etapas/<%= etapa.id %>/preparacion" style="margin-top:8px">
              <button class="boton boton--secundario" type="submit">
                <i class="ti ti-refresh" aria-hidden="true"></i> Reintentar
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <p class="etapa-resumen" id="resumen-apuntados">
        <i class="ti ti-bookmark" aria-hidden="true"></i>
        Tienes <strong id="cuenta-apuntados"><%= queVer.apuntados %></strong>
        <span id="palabra-apuntados"><%= queVer.apuntados === 1 ? 'cosa apuntada' : 'cosas apuntadas' %></span>
        en <%= etapa.nombre_ciudad %>.
      </p>

      <%# SUBPESTAÑAS.
          "Qué ver" mezclaba dos cosas que no se parecen: los sitios de la
          ciudad y las excursiones de Civitatis, estas últimas en un carrusel
          horizontal larguísimo donde no se veía lo que había. Ahora cada una
          tiene lo suyo, en lista vertical, y se ve todo bajando con la página.

          La lista de abajo es la que manda: para añadir "Comer" o "Bares" basta
          con meter una entrada aquí y su <section class="subpanel"> más abajo.
          El JS no sabe cuántas hay ni cómo se llaman. %>
      <% const SUBVISTAS = [
           { clave: 'sitios',      etiqueta: 'Sitios',      icono: 'ti-map-pin', n: queVer.sitios.length },
           { clave: 'excursiones', etiqueta: 'Excursiones', icono: 'ti-ticket',  n: queVer.excursiones.length },
           { clave: 'comer',       etiqueta: 'Comer',       icono: 'ti-tools-kitchen-2',
             n: comer.apuntadas.length + comer.resultados.length },
           { clave: 'moverse',     etiqueta: 'Moverse',     icono: 'ti-bus',     n: moverse.fichas.length },
         ]; %>

      <div class="subpestanas" role="tablist" aria-label="Qué ver en <%= etapa.nombre_ciudad %>">
        <% SUBVISTAS.forEach((s, i) => { %>
          <%# Igual que arriba: la que venga en `vista`, no siempre la primera.
              Y esta importa aún más, porque "Comer" y "Moverse" viven aquí
              dentro: buscar un restaurante te devolvía a "Sitios". %>
          <button class="subpestana <%= vista.subpestana === ('sub-' + s.clave) ? 'subpestana--activa' : '' %>"
                  type="button" role="tab"
                  aria-selected="<%= vista.subpestana === ('sub-' + s.clave) %>" data-subpanel="sub-<%= s.clave %>">
            <i class="ti <%= s.icono %>" aria-hidden="true"></i>
            <%= s.etiqueta %>
            <span class="subpestana__n"><%= s.n %></span>
          </button>
        <% }) %>
      </div>

      <%# --- Sitios: los de la ficha profunda de la ciudad --- %>
      <section class="subpanel" id="sub-sitios" role="tabpanel" <%= vista.subpestana === 'sub-sitios' ? '' : 'hidden' %>>
        <% if (!queVer.sitios.length) { %>
          <p class="candidatos__vacio">
            <%= preparando.trabajando
                  ? 'Buscando qué hay que ver aquí…'
                  : 'Todavía no hay sitios de esta ciudad en el catálogo.' %>
          </p>
        <% } %>

        <div class="rejilla-fichas">
          <% queVer.sitios.forEach(s => { %>
            <%- include('parciales/ficha-sitio', { s, viaje, etapa, colocaciones, diasDeLaEtapa, queVer }) %>
          <% }) %>
        </div>
      </section>

      <%# --- Excursiones: las de Civitatis, en rejilla vertical --- %>
      <section class="subpanel" id="sub-excursiones" role="tabpanel" <%= vista.subpestana === 'sub-excursiones' ? '' : 'hidden' %>>
        <% if (!queVer.excursiones.length) { %>
          <p class="candidatos__vacio">
            <%= preparando.trabajando
                  ? 'Buscando excursiones en ' + etapa.nombre_ciudad + '…'
                  : 'No hay excursiones de ' + etapa.nombre_ciudad + ' en el catálogo.' %>
          </p>
        <% } %>

        <div class="rejilla-fichas">
          <% queVer.excursiones.forEach(c => { %>
            <%- include('parciales/excursion', { c, viaje, etapa, colocaciones, diasDeLaEtapa }) %>
          <% }) %>
        </div>
      </section>

      <%# --- Comer: bares y restaurantes --- %>
      <section class="subpanel" id="sub-comer" role="tabpanel" <%= vista.subpestana === 'sub-comer' ? '' : 'hidden' %>>
        <div class="titulo-con-accion">
          <p class="secundario" style="margin:0">
            Dónde comer y dónde tomar algo en <%= etapa.nombre_ciudad %>.
          </p>
          <button class="boton boton--secundario" type="button" id="nueva-comer">
            <i class="ti ti-plus" aria-hidden="true"></i> A mano
          </button>
        </div>

        <%# EL CAMPO LIBRE ES LO QUE HACE ÚTIL LA BÚSQUEDA. "Cenar tranquilo
            cerca del hotel" no se puede pedir con filtros; se escribe. Y el
            botón de al lado busca lo mejor sin más, que es el otro 90 %. %>
        <form class="comer-buscador" id="buscador-comer" data-etapa="<%= etapa.id %>">
          <label class="comer-buscador__campo">
            <span>Qué te apetece</span>
            <input type="text" name="consulta" maxlength="200" autocomplete="off"
                   placeholder="Cenar tranquilo cerca del hotel, de tapas por el centro…"
                   <%= comer.buscando ? 'disabled' : '' %>>
          </label>
          <button class="boton boton--primario" type="submit" <%= comer.buscando ? 'disabled' : '' %>>
            <i class="ti <%= comer.buscando ? 'ti-loader-2 girando' : 'ti-search' %>" aria-hidden="true"></i>
            <span><%= comer.buscando ? 'Buscando…' : 'Buscar' %></span>
          </button>
          <button class="boton boton--secundario" type="button" id="comer-rapido"
                  <%= comer.buscando ? 'disabled' : '' %>>
            <i class="ti ti-star" aria-hidden="true"></i>
            Los mejores de <%= etapa.nombre_ciudad %>
          </button>
        </form>

        <% if (comer.buscando) { %>
          <div class="franja franja--trabajando">
            <span class="rueda" aria-hidden="true"></span>
            <span>Buscando dónde comer en <%= etapa.nombre_ciudad %>…</span>
            <span class="franja__pista secundario">Se recarga sola cuando esté.</span>
          </div>
        <% } else if (comer.mensajeError) { %>
          <div class="aviso aviso--alerta">
            <i class="ti ti-alert-octagon" aria-hidden="true"></i>
            <div>
              <p class="aviso__texto"><%= comer.mensajeError %></p>
              <p class="aviso__texto secundario">Puedes escribir fichas a mano igualmente.</p>
            </div>
          </div>
        <% } %>

        <% if (!comer.fichas.length && !comer.buscando) { %>
          <p class="candidatos__vacio">
            Todavía no has buscado dónde comer en <%= etapa.nombre_ciudad %>.
          </p>
        <% } %>

        <%# TRES MONTONES, Y ANTES ERA UNO SOLO.
            Madrid llegó a tener setenta y una fichas aquí porque cada búsqueda
            añadía doce y ninguna se iba. Lo que uno se apunta es suyo y no
            caduca; lo que sale de una consulta es de usar y tirar. %>

        <% if (comer.apuntadas.length) { %>
          <div class="seccion-cabecera seccion-cabecera--fina">
            <h4 class="seccion-cabecera__titulo">
              <i class="ti ti-bookmark-filled" aria-hidden="true"></i>
              Los que me he apuntado
              <span class="pastilla"><%= comer.apuntadas.length %></span>
            </h4>
          </div>
          <div class="rejilla-fichas" id="lista-comer">
            <% comer.apuntadas.forEach(c => { %>
              <%- include('parciales/ficha-comer', {
                    c, etapa, viaje, colocaciones, diasDeLaEtapa,
                    distancias: distanciasComer.get(c.id) ?? [],
                  }) %>
            <% }) %>
          </div>
        <% } %>

        <% if (comer.resultados.length) { %>
          <div class="seccion-cabecera seccion-cabecera--fina">
            <h4 class="seccion-cabecera__titulo">
              <i class="ti ti-search" aria-hidden="true"></i>
              De la última búsqueda
              <span class="pastilla"><%= comer.resultados.length %></span>
            </h4>
            <p class="seccion-cabecera__pie">
              Se irán en cuanto busques otra cosa. Apunta los que quieras conservar.
            </p>
          </div>
          <div class="rejilla-fichas" <%= comer.apuntadas.length ? '' : 'id="lista-comer"' %>>
            <% comer.resultados.forEach(c => { %>
              <%- include('parciales/ficha-comer', {
                    c, etapa, viaje, colocaciones, diasDeLaEtapa,
                    distancias: distanciasComer.get(c.id) ?? [],
                  }) %>
            <% }) %>
          </div>
        <% } %>

        <%# Lo de búsquedas anteriores. No se borra —cada ficha costó una
            llamada a Places y el próximo viaje la reutiliza— pero se guarda
            plegado, que es donde no estorba. %>
        <% if (comer.historico.length) { %>
          <details class="comer-historico">
            <summary>
              <i class="ti ti-history" aria-hidden="true"></i>
              De búsquedas anteriores <span class="pastilla"><%= comer.historico.length %></span>
            </summary>
            <div class="rejilla-fichas">
              <% comer.historico.forEach(c => { %>
                <%- include('parciales/ficha-comer', {
                      c, etapa, viaje, colocaciones, diasDeLaEtapa,
                      distancias: distanciasComer.get(c.id) ?? [],
                    }) %>
              <% }) %>
            </div>
          </details>
        <% } %>
      </section>

      <%# --- Moverse: el transporte urbano de la ciudad --- %>
      <section class="subpanel" id="sub-moverse" role="tabpanel" <%= vista.subpestana === 'sub-moverse' ? '' : 'hidden' %>>

        <%# LOS TRASLADOS VAN ARRIBA. Es lo que más se usa de esta pestaña:
            "¿cuánto hay del hotel al centro?" se pregunta veinte veces
            planificando un día, y las fichas de metro y taxi se miran una. %>
        <%# A dónde se puede ir desde aquí, para que el buscador sepa si lo
            tecleado es algo del viaje o una dirección suelta. SIN COORDENADAS:
            el servidor ya las quita, y aquí no harían ninguna falta. %>
        <script type="application/json" id="datos-lugares"><%- JSON.stringify(lugares) %></script>

        <%# El objeto entero, no solo la lista: el parcial separa los fijados
            del historial y necesita las dos partes. %>
        <%- include('parciales/traslados', {
              traslados, lugares, etapa, viaje, diasDeLaEtapa,
            }) %>

        <hr class="separador-suave">

        <%# LA SEGUNDA MITAD DE LA PESTAÑA, y se dice que lo es.
            Antes las dos cosas —los traslados punto a punto y las fichas de
            metro y taxi— caían una detrás de otra sin nada que las separase, y
            la pantalla parecía una sola lista revuelta. Son dos preguntas
            distintas: "cuánto hay de aquí a allá" y "cómo funciona el
            transporte de esta ciudad". %>
        <div class="seccion-cabecera">
          <h3 class="seccion-cabecera__titulo">
            <i class="ti ti-bus" aria-hidden="true"></i> Transporte en la ciudad
          </h3>
          <p class="seccion-cabecera__pie">
            Metro, buses, taxis con su teléfono y lo peculiar de <%= etapa.nombre_ciudad %>.
          </p>
          <span class="seccion-cabecera__acciones">
            <button class="boton boton--secundario" type="button" id="buscar-movilidad"
                    data-etapa="<%= etapa.id %>" <%= moverse.buscando ? 'disabled' : '' %>>
              <i class="ti <%= moverse.buscando ? 'ti-loader-2 girando' : 'ti-sparkles' %>" aria-hidden="true"></i>
              <span><%= moverse.buscando ? 'Buscando…' : (moverse.fichas.length ? 'Buscar otra vez' : 'Buscar cómo moverse') %></span>
            </button>
            <button class="boton boton--secundario" type="button" id="nueva-movilidad">
              <i class="ti ti-plus" aria-hidden="true"></i> A mano
            </button>
          </span>
        </div>

        <% if (moverse.buscando) { %>
          <div class="franja franja--trabajando" id="movilidad-trabajando"
               data-etapa="<%= etapa.id %>">
            <span class="rueda" aria-hidden="true"></span>
            <span>Buscando en la web cómo moverse por <%= etapa.nombre_ciudad %>…</span>
            <span class="franja__pista secundario">Se recarga sola cuando esté.</span>
          </div>
        <% } else if (moverse.mensajeError) { %>
          <div class="aviso aviso--alerta">
            <i class="ti ti-alert-octagon" aria-hidden="true"></i>
            <div>
              <div class="aviso__titulo">No se pudo consultar</div>
              <p class="aviso__texto"><%= moverse.mensajeError %></p>
              <p class="aviso__texto secundario">Puedes crear las fichas a mano igualmente.</p>
            </div>
          </div>
        <% } %>

        <% if (!moverse.fichas.length && !moverse.buscando) { %>
          <p class="candidatos__vacio">
            Todavía no hay nada sobre cómo moverse por <%= etapa.nombre_ciudad %>.
            Búscalo con la IA o crea una ficha a mano.
          </p>
        <% } %>

        <%# DOS POR FILA, no tres. Estas fichas llevan teléfono, web, horarios y
            dirección: en una columna de 244 px el contenido no cabe y empujaba
            la rejilla hasta descuadrarla —las columnas salían de 352, 218 y 184
            píxeles en vez de repartidas—. Con dos caben, y siguen siendo
            tarjetas, no franjas de ancho completo. %>
        <div class="rejilla-fichas rejilla-fichas--dos" id="lista-movilidad">
          <% moverse.fichas.forEach(m => { %>
            <%- include('parciales/ficha-movilidad', { m, etapa, diasDeLaEtapa }) %>
          <% }) %>
        </div>
      </section>
    </section>

    <%# ---------------------- 2) DÓNDE DORMIR ---------------------- %>
    <section class="panel" id="panel-dormir" role="tabpanel" <%= vista.pestana === 'dormir' ? '' : 'hidden' %>>
      <% if (dormir.estado === 'sin_fechas') { %>
        <div class="caja vacio">
          <i class="ti ti-calendar-off" style="font-size:28px;color:var(--texto-3)" aria-hidden="true"></i>
          <p style="margin-top:10px">Sin fechas no se puede cotizar un hotel.</p>
          <p class="secundario" style="margin-top:4px">
            Confirma esta parada en la ruta y dile cuántas noches te quedas.
          </p>
          <a class="boton boton--primario" href="/viaje/<%= viaje.id %>/ruta">
            <i class="ti ti-route" aria-hidden="true"></i> Ir a la ruta
          </a>
        </div>

      <% } else if (dormir.estado === 'buscando') { %>
        <div class="buscando" id="buscando-hoteles"
             data-estado-url="/etapa/<%= etapa.id %>/estado">
          <i class="ti ti-plane buscando__avion" aria-hidden="true"></i>
          <div class="buscando__titulo">Buscando alojamiento en <%= etapa.nombre_ciudad %>…</div>
          <p class="buscando__nota">
            Se abrirá una ventana de Chrome en el servidor: <strong>no la cierres</strong>.
          </p>
          <div class="buscando__pista secundario" id="buscando-pista">Comprobando cada 5 segundos…</div>
        </div>

      <% } else { %>
        <%# ANTES DE BUSCAR SE PREGUNTA CÓMO.
            Entrar en esta pestaña ya no dispara una búsqueda de Booking: se
            enseñan los filtros y se busca cuando se pulsa el botón. Y el
            formulario vive AQUÍ DENTRO; el botón "Filtros" que echaba a la
            pantalla del wizard era justo lo contrario de lo que hace falta:
            se buscaba en un sitio y se filtraba en otro. %>
        <% const hayHoteles = dormir.estado === 'hecho' && dormir.hoteles.length; %>

        <% if (dormir.estado === 'error') { %>
          <div class="aviso aviso--alerta">
            <i class="ti ti-alert-octagon" aria-hidden="true"></i>
            <div>
              <div class="aviso__titulo">No se pudieron traer los alojamientos</div>
              <p class="aviso__texto"><%= dormir.trabajo?.mensaje_error || 'Error desconocido.' %></p>
            </div>
          </div>
        <% } %>

        <% if (hayHoteles) { %>
          <%# Con resultados: el resumen arriba y el formulario plegado detrás
              de "Cambiar filtros". Nunca se sale de esta pantalla. %>
          <p class="filtros-resumen">
            <i class="ti ti-filter" aria-hidden="true"></i> <%= resumenFiltrosHoteles %>
            <% if (dormir.ocultosPorDistancia) { %>
              <span class="secundario">· <%= dormir.ocultosPorDistancia %> ocultos por distancia</span>
            <% } %>
            <button class="enlace-boton" type="button"
                    data-plegar="panel-filtros-hotel-etapa">Cambiar filtros</button>
          </p>
        <% } else { %>
          <div class="caja vacio">
            <i class="ti ti-bed" style="font-size:28px;color:var(--texto-3)" aria-hidden="true"></i>
            <p style="margin-top:10px">
              Todavía no has buscado dónde dormir en <%= etapa.nombre_ciudad %>.
            </p>
            <p class="secundario" style="margin-top:4px">
              Se buscará con las fechas de esta parada: <strong><%= rango %></strong>.
              Elige abajo cómo quieres que sea y pulsa <strong>Buscar hoteles</strong>.
            </p>
          </div>
        <% } %>

        <%# El mismo formulario del paso 6, aquí dentro. Abierto cuando todavía
            no hay nada buscado —que es cuando hay que decidir— y plegado
            cuando ya hay resultados en pantalla. %>
        <%- include('parciales/filtros-hotel', {
              filtros: filtrosHoteles,
              accion: `/etapa/${etapa.id}/hoteles/filtros`,
              idPanel: 'panel-filtros-hotel-etapa',
              abierto: !hayHoteles,
              textoBoton: 'Buscar hoteles',
              urlDistancia: hayHoteles ? `/viajes/${viaje.id}/hoteles/distancia` : null,
            }) %>

        <% if (hayHoteles) { %>
          <%# --- El elegido, destacado arriba ---
              LA CAJA EXISTE SIEMPRE, aunque esté vacía.
              Antes solo se pintaba si ya había un hotel elegido, y por eso al
              elegir uno no pasaba nada visible: el círculo se marcaba y esta
              ficha seguía como estaba hasta cambiar de pestaña y volver.
              Con la caja siempre presente, el JS la rellena al momento. %>
          <div class="elegido" data-hotel-elegido data-ciudad="<%= etapa.nombre_ciudad %>"
               <%= dormir.elegido ? '' : 'hidden' %>>
            <% if (dormir.elegido) { %>
              <div class="elegido__marca">
                <i class="ti ti-check" aria-hidden="true"></i> Tu alojamiento en <%= etapa.nombre_ciudad %>
              </div>
              <div class="elegido__nombre"><%= dormir.elegido.titulo %></div>
              <div class="elegido__pie">
                <span class="elegido__precio">
                  <%= dormir.elegido.precio != null ? dormir.elegido.precio + ' ' + (dormir.elegido.moneda || 'EUR') : '—' %>
                </span>
                <% if (dormir.elegido.url) { %>
                  <a class="elegido__enlace" href="<%= dormir.elegido.url %>" target="_blank" rel="noopener noreferrer">
                    Ver en Booking <i class="ti ti-external-link" aria-hidden="true"></i>
                  </a>
                <% } %>
                <button class="boton-discreto" type="button" id="cambiar-hotel">
                  <i class="ti ti-switch-horizontal" aria-hidden="true"></i> Cambiar
                </button>
              </div>

              <%# Dónde está. Es el extremo de casi todos los traslados del día:
                  se sale de dormir y se vuelve a dormir. %>
              <%- include('parciales/direccion', {
                    tipo: 'hotel', elementoId: dormir.elegido.id,
                    direccion: dormir.elegido.direccion, viaje,
                  }) %>

              <%# La confirmación de la reserva y el correo con las instrucciones
                  de entrada, que es justo lo que hace falta al llegar. %>
              <%- include('parciales/adjuntos', {
                    tipo: 'alojamiento', elementoId: dormir.elegido.id,
                    adjuntos: dormir.elegido.adjuntos ?? [],
                    etiqueta: 'Reserva e instrucciones',
                  }) %>
            <% } %>
          </div>

          <div id="lista-hoteles" <%= dormir.elegido ? 'hidden' : '' %>>
            <div class="titulo-con-accion">
              <div class="chips">
                <% ORDENES.forEach(o => { %>
                  <a class="chip <%= orden === o.valor ? 'chip--activo' : '' %>"
                     href="/etapa/<%= etapa.id %>?orden=<%= o.valor %>&p=dormir">
                    <i class="ti <%= o.icono %>" aria-hidden="true"></i> <%= o.etiqueta %>
                  </a>
                <% }) %>
              </div>
              <form method="POST" action="/etapa/<%= etapa.id %>/hoteles/buscar">
                <button class="boton-discreto" type="submit" title="Vuelve a buscar en Booking con las fechas de esta parada.">
                  <i class="ti ti-refresh" aria-hidden="true"></i> Actualizar
                </button>
              </form>
            </div>

            <div class="rejilla rejilla--una aireado" style="gap:10px">
              <% dormir.hoteles.forEach(h => { %>
                <%- include('parciales/hotel', {
                      h, idBarato, idMejor,
                      urlMarcar: `/etapa/${etapa.id}/hoteles/${h.id}/elegir`
                    }) %>
              <% }) %>
            </div>
          </div>
        <% } %>
      <% } %>
    </section>

    <%# ---------------------- 3) CÓMO LLEGAR ---------------------- %>
    <section class="panel" id="panel-llegar" role="tabpanel" <%= vista.pestana === 'llegar' ? '' : 'hidden' %>>
      <% if (!tramos.length) { %>
        <p class="candidatos__vacio">
          Esta parada todavía no tiene tramos. Confírmala en la ruta y aparecerán.
        </p>
      <% } %>

      <% tramos.forEach(t => { %>
        <article class="tramo-caja <%= t.resuelto ? 'tramo-caja--resuelta' : '' %>" id="tramo-<%= t.id %>" data-tramo="<%= t.id %>">
          <header class="tramo-caja__cabecera">
            <span class="tramo-caja__ruta">
              <i class="ti <%= ICONO_TIPO[t.tipo] || 'ti-arrow-right' %>" aria-hidden="true"></i>
              <%= t.nombreOrigen %> <i class="ti ti-arrow-narrow-right" aria-hidden="true"></i> <%= t.nombreDestino %>
            </span>
            <%# Con `data-estado-tramo` el JS puede pasarlo a "Resuelto" en cuanto
                se elige un medio. Antes esto solo lo pintaba el servidor, así
                que elegir un tren dejaba el tramo en "Pendiente" hasta entrar a
                editar y guardar sin tocar nada. %>
            <span class="tramo-caja__estado <%= t.resuelto ? 'tramo-caja__estado--ok' : '' %>"
                  data-estado-tramo="<%= t.id %>">
              <i class="ti <%= t.resuelto ? 'ti-check' : 'ti-alert-triangle' %>" aria-hidden="true"></i>
              <%= t.resuelto ? 'Resuelto' : 'Pendiente' %>
            </span>
          </header>

          <p class="tramo-caja__datos">
            <% if (t.fecha) { %><span><i class="ti ti-calendar" aria-hidden="true"></i> <%= dia(t.fecha) %></span><% } %>
            <% if (t.referencia) { %><span class="tramo-caja__referencia"><%= t.referencia %></span><% } %>
          </p>

          <% if (t.resuelto) { %>
            <div class="tramo-caja__resuelto">
              <strong data-resumen-tramo="<%= t.id %>"><%= t.resumen %></strong>
              <% if (t.medio) { %>
                <p class="tramo-caja__medio">
                  <i class="ti <%= t.medio.icono %>" aria-hidden="true"></i>
                  <%= [t.medio.nombre, t.medio.referencia && `reserva ${t.medio.referencia}`]
                        .filter(Boolean).join(' · ') %>
                </p>
                <% if (t.medio.notaPropia) { %>
                  <p class="secundario" style="margin:2px 0 0"><%= t.medio.notaPropia %></p>
                <% } %>
              <% } %>
              <% if (t.notas) { %><p class="secundario" style="margin:4px 0 0"><%= t.notas %></p><% } %>
              <% if (t.precioEstimado) { %>
                <p class="secundario" style="margin:2px 0 0"><%= t.precioEstimado %> € aprox.</p>
              <% } %>
            </div>
          <% } %>

          <div class="tramo-caja__acciones">
            <%# UN SOLO NIVEL.
                Antes había un botón "Cómo llegar" que abría un panel donde
                dentro había OTRO botón "Buscar cómo llegar" y una caja de
                avión. Dos capas para tres acciones que caben en una fila: se
                buscan los medios, se busca vuelo, o se escribe uno a mano.
                El panel de abajo ya solo enseña resultados. %>

            <% if (t.medios) { %>
              <button class="boton boton--secundario" type="button"
                      data-buscar-medios="<%= t.id %>" <%= t.medios.buscando ? 'disabled' : '' %>>
                <i class="ti <%= t.medios.buscando ? 'ti-loader-2 girando' : 'ti-route-2' %>" aria-hidden="true"></i>
                <span><%= t.medios.buscando
                      ? 'Buscando…'
                      : t.medios.delCatalogo
                        ? `Buscar otra vez (${t.medios.delCatalogo})`
                        : 'Buscar cómo llegar' %></span>
              </button>
            <% } %>

            <%# El vuelo, al mismo nivel. Hay tramos largos donde sí se vuela, y
                los de casa y a casa son siempre vuelo. %>
            <button class="boton boton--secundario" type="button" data-vuelos="<%= t.id %>">
              <i class="ti ti-plane" aria-hidden="true"></i>
              <%= t.resultados.estado === 'hecho' && t.resultados.vuelos.length
                    ? `Ver vuelos (${t.resultados.vuelos.length})`
                    : 'Buscar vuelo' %>
            </button>

            <% if (t.medios) { %>
              <button class="boton boton--secundario" type="button" data-nuevo-medio="<%= t.id %>">
                <i class="ti ti-plus" aria-hidden="true"></i> Añadir medio
              </button>
            <% } %>

            <button class="boton boton--secundario" type="button" data-manual="<%= t.id %>">
              <i class="ti ti-pencil" aria-hidden="true"></i>
              <%= t.resuelto && t.notas ? 'Editar a mano' : 'Apuntar a mano' %>
            </button>
            <% if (t.notas) { %>
              <button class="boton-discreto" type="button" data-olvidar="<%= t.id %>">Quitar</button>
            <% } %>
          </div>

          <%# Los papeles de este tramo: billetes, tarjetas de embarque de todos
              los viajeros. Cuelgan del TRAMO y no del vuelo elegido, porque
              siguen valiendo aunque cambie de vuelo dentro del mismo trayecto. %>
          <%- include('parciales/adjuntos', {
                tipo: 'transporte', elementoId: t.id, adjuntos: t.adjuntos,
                etiqueta: 'Billetes y tarjetas de embarque',
              }) %>

          <%# Formulario manual, plegado hasta que se pide. %>
          <form class="manual" data-form-manual="<%= t.id %>" hidden>
            <div class="manual__fila">
              <label class="manual__campo">
                <span>Cómo vas</span>
                <select name="tipo">
                  <% tiposTransporte.forEach(x => { %>
                    <option value="<%= x.valor %>" <%= t.tipo === x.valor ? 'selected' : '' %>><%= x.etiqueta %></option>
                  <% }) %>
                </select>
              </label>
              <label class="manual__campo manual__campo--precio">
                <span>Precio aprox. (€)</span>
                <input type="number" name="precio" min="0" step="1" value="<%= t.precioEstimado ?? '' %>">
              </label>
            </div>
            <label class="manual__campo">
              <span>Notas</span>
              <input type="text" name="notas" maxlength="200"
                     placeholder="Shinkansen Hikari, ~2h15, cubierto con el JR Pass"
                     value="<%= t.notas ?? '' %>">
            </label>
            <div class="manual__botones">
              <button class="boton boton--primario" type="submit">Guardar</button>
              <button class="boton boton--secundario" type="button" data-cancelar-manual>Cancelar</button>
            </div>
          </form>

          <%# CÓMO LLEGAR: los medios por tierra o mar de esta pareja de ciudades.
              Vienen del CATÁLOGO, así que el próximo viaje que pase por aquí ya
              los tiene. El avión no está en esta lista: tiene su propio botón,
              que lleva al buscador de Kayak. %>
          <% if (t.medios) { %>
            <%# El panel es SOLO resultados: los botones viven arriba, con los
                demás del tramo. Se ve cuando hay algo que enseñar y se esconde
                cuando no, sin botón que lo despliegue. %>
            <div class="medios-tramo" data-medios-de="<%= t.id %>"
                 <%= t.medios.delCatalogo || t.medios.elegidaId || t.medios.buscando ? '' : 'hidden' %>>

              <p class="secundario" style="margin:0">
                Cómo ir de <strong><%= t.nombreOrigen %></strong> a
                <strong><%= t.nombreDestino %></strong>
              </p>

              <% if (t.medios.buscando) { %>
                <div class="franja franja--trabajando" data-medios-trabajando="<%= t.id %>">
                  <span class="rueda" aria-hidden="true"></span>
                  <span>Buscando en la web cómo ir de <%= t.nombreOrigen %> a <%= t.nombreDestino %>…</span>
                </div>
              <% } else if (t.medios.mensajeError) { %>
                <div class="aviso aviso--alerta">
                  <i class="ti ti-alert-octagon" aria-hidden="true"></i>
                  <div>
                    <p class="aviso__texto"><%= t.medios.mensajeError %></p>
                    <p class="aviso__texto secundario">Puedes crear las fichas a mano igualmente.</p>
                  </div>
                </div>
              <% } %>

              <div class="rejilla-fichas">
                <% t.medios.fichas.forEach(f => { %>
                  <%- include('parciales/ficha-transporte', { f, transporteId: t.id }) %>
                <% }) %>
              </div>
            </div>
          <% } %>

          <%# LOS VUELOS DE ESTE TRAMO.
              Se busca SOLO ESTE SENTIDO y SOLO ESTA FECHA: BCN→Madrid del 11 y
              Madrid→BCN del 13 son dos búsquedas distintas, cada una con sus
              horarios y con SUS filtros. Por eso el panel de filtros está aquí
              dentro, uno por tramo, y no en una pantalla aparte: puedo querer
              directos a la ida y que me dé igual a la vuelta. %>
          <%# CUÁNDO SE ABRE SOLA, y cuándo no.
              Mientras busca y si falla, sí: el mensaje quedaría escondido
              detrás del botón. Con resultados sin elegir, también: hay una
              decisión pendiente y esconderla no ayuda.

              PERO CON EL TRAMO YA RESUELTO, NO. Antes se abría igualmente, así
              que cualquier acción o recarga volvía a desplegar los quince
              vuelos de un trayecto ya decidido y te mandaba al principio de la
              lista. Plegado es el estado natural de algo resuelto; "Ver vuelos
              (15)" lo reabre cuando se quiera. %>
          <div class="vuelos-tramo" data-vuelos-de="<%= t.id %>"
               <%= (t.resultados.estado === 'hecho' && t.resultados.vuelos.length && !t.resuelto)
                    || t.resultados.estado === 'buscando'
                    || t.resultados.estado === 'error' ? '' : 'hidden' %>>

            <% if (t.resultados.estado === 'buscando') { %>
              <p class="secundario" data-buscando-tramo="<%= t.id %>">
                <span class="rueda" aria-hidden="true"></span>
                Buscando <%= t.nombreOrigen %> → <%= t.nombreDestino %> en Kayak…
                se abrirá una ventana de Chrome en el servidor.
                <span class="secundario" data-pista-tramo="<%= t.id %>"></span>
              </p>

            <% } else { %>
              <% const hayVuelos = t.resultados.estado === 'hecho'; %>

              <% if (t.resultados.estado === 'error') { %>
                <div class="aviso aviso--alerta">
                  <i class="ti ti-alert-octagon" aria-hidden="true"></i>
                  <div><p class="aviso__texto"><%= t.resultados.mensaje_error || 'Error desconocido.' %></p></div>
                </div>
              <% } %>

              <% if (hayVuelos) { %>
                <div class="titulo-con-accion">
                  <div class="chips">
                    <% [['precio','Precio','ti-coin'], ['duracion','Más rápidos','ti-clock-bolt']].forEach(([valor, etiqueta, icono]) => { %>
                      <a class="chip <%= ordenVuelos === valor ? 'chip--activo' : '' %>"
                         href="/etapa/<%= etapa.id %>?ordenVuelos=<%= valor %>&p=llegar">
                        <i class="ti <%= icono %>" aria-hidden="true"></i> <%= etiqueta %>
                      </a>
                    <% }) %>
                  </div>
                </div>

                <p class="filtros-resumen">
                  <i class="ti ti-filter" aria-hidden="true"></i> <%= t.resultados.resumenFiltros %>
                  <% if (t.resultados.ocultosPorFiltros) { %>
                    <span class="secundario">· <%= t.resultados.ocultosPorFiltros %> ocultos por filtros</span>
                  <% } %>
                  <button class="enlace-boton" type="button"
                          data-plegar="filtros-tramo-<%= t.id %>">Cambiar filtros</button>
                </p>
              <% } else { %>
                <p class="secundario" style="margin:0 0 4px">
                  Se buscará <strong><%= t.nombreOrigen %> → <%= t.nombreDestino %></strong><%
                    if (t.fecha) { %> del <strong><%= dia(t.fecha) %></strong><% }
                  %>, solo ida. Elige cómo quieres volar y pulsa <strong>Buscar vuelos</strong>.
                </p>
              <% } %>

              <%- include('parciales/filtros-vuelo', {
                    filtros: t.filtros,
                    accion: `/tramo/${t.id}/vuelos/buscar`,
                    idPanel: `filtros-tramo-${t.id}`,
                    abierto: !hayVuelos,
                    textoBoton: 'Buscar vuelos',
                    pax: (viaje.adultos || 1) + (viaje.ninos || 0),
                    soloIda: true,
                    ocultos: [['volverA', `/etapa/${etapa.id}`]],
                  }) %>

              <% if (hayVuelos) { %>
                <%# Que los filtros dejen la lista vacía NO es lo mismo que no
                    haber buscado: hay que decirlo con esas palabras o parece
                    que la búsqueda falló. %>
                <% if (!t.resultados.vuelos.length) { %>
                  <p class="candidatos__vacio">
                    Ningún vuelo cumple los filtros — afloja alguno o vuelve a buscar.
                  </p>
                <% } %>

                <% t.resultados.vuelos.forEach(v => { %>
                  <%- include('parciales/vuelo', {
                        v,
                        idBarata: t.resultados.idBarata,
                        idRapida: t.resultados.idRapida,
                        fechaIda: dia(t.fechaIda),
                        fechaVuelta: dia(t.fechaVuelta),
                        urlMarcar: `/tramo/${t.id}/vuelos/${v.id}/marcar`
                      }) %>
                <% }) %>
              <% } %>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <%# ---------------------- 4) MAPA ----------------------
        Un mapa de CONSULTA: dónde cae cada cosa respecto al hotel. No se añade,
        no se edita y no se borra desde aquí; para eso están las otras pestañas.

        Las coordenadas viajan en el `data-mapa` porque hay que dibujar puntos,
        pero no se enseñan en ninguna parte: lo que se lee es el nombre y a
        cuántos minutos está. %>
    <section class="panel" id="panel-mapa" role="tabpanel" <%= vista.pestana === 'mapa' ? '' : 'hidden' %>>
      <div class="titulo-con-accion">
        <p class="secundario" style="margin:0">
          Todo lo que tienes en <%= etapa.nombre_ciudad %>, y a cuánto está del hotel.
        </p>
        <span class="mapa-leyenda" id="mapa-etapa-leyenda"></span>
      </div>

      <% if (!mapaEtapa.elementos.length) { %>
        <p class="candidatos__vacio">
          Todavía no hay nada situado en <%= etapa.nombre_ciudad %>. Apunta sitios,
          excursiones o restaurantes y elige hotel, y aparecerán aquí.
        </p>
      <% } else { %>
        <div class="mapa-etapa" id="mapa-etapa"
             data-clave-mapas="<%= claveMapas %>"
             data-mapa='<%= JSON.stringify(mapaEtapa) %>'></div>

        <%# Tres estados y tres frases. "No hay hotel" y "el hotel no está
            situado" son cosas distintas: en la segunda el hotel está elegido y
            lo que falta es su dirección. %>
        <% if (!mapaEtapa.hotelElegido) { %>
          <p class="mapa-etapa__nota">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            No hay hotel elegido en esta parada, así que no se pueden medir distancias
            desde él. Elige uno en «Dónde dormir».
          </p>
        <% } else if (!mapaEtapa.hotelEnElMapa) { %>
          <p class="mapa-etapa__nota">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            «<%= mapaEtapa.nombreDelHotel %>» está elegido pero no tiene dirección situada,
            así que no sale en el mapa ni sirve de referencia. Puedes escribirla en
            «Dónde dormir».
          </p>
        <% } %>

        <%# LOS QUE NO SE PUEDEN SITUAR SE CUENTAN, no desaparecen.
            Que falte algo del mapa sin decir nada hace pensar que el mapa está
            roto; decir cuántos faltan hace pensar que faltan direcciones, que
            es lo que pasa de verdad. %>
        <% if (mapaEtapa.sinSituar.length) { %>
          <p class="mapa-etapa__nota">
            <i class="ti ti-map-pin-off" aria-hidden="true"></i>
            <%= mapaEtapa.sinSituar.length %>
            <%= mapaEtapa.sinSituar.length === 1 ? 'sitio no está' : 'sitios no están' %>
            en el mapa porque no <%= mapaEtapa.sinSituar.length === 1 ? 'tiene' : 'tienen' %>
            dirección situada:
            <%= mapaEtapa.sinSituar.map(x => x.nombre).join(', ') %>.
          </p>
        <% } %>
      <% } %>
    </section>

    <%# ======================= NAVEGACIÓN ======================= %>
    <nav class="etapa-nav">
      <% if (anterior) { %>
        <a class="boton-discreto" href="/etapa/<%= anterior.id %>">
          <i class="ti ti-arrow-left" aria-hidden="true"></i> <%= anterior.nombre_ciudad %>
        </a>
      <% } else { %><span></span><% } %>

      <a class="boton-lienzo" href="/viaje/<%= viaje.id %>/ruta">
        <i class="ti ti-route" aria-hidden="true"></i> Ver la ruta completa
      </a>

      <% if (siguiente) { %>
        <a class="boton-discreto" href="/etapa/<%= siguiente.id %>">
          <%= siguiente.nombre_ciudad %> <i class="ti ti-arrow-right" aria-hidden="true"></i>
        </a>
      <% } else { %><span></span><% } %>
    </nav>
  </div>
</main>



<%# ===========================================================================
    LA PESTAÑA, REPUESTA ANTES DE PINTAR
    ---------------------------------------------------------------------------
    Va aquí, en línea y sin `defer`, a propósito: el navegador lo ejecuta al
    encontrarlo, ANTES de pintar. Con etapa.js —75 KB que se descargan, se
    analizan y se ejecutan después— la pestaña buena tardaba en volver lo justo
    para verse el salto: 214 ms medidos en local, más por la red.

    En el caso normal no hace nada, porque la pestaña viene en la URL y el
    servidor ya la ha pintado. Esto cubre lo otro: llegar sin nada en la URL
    —un enlace de fuera, un marcador, un redirect— teniendo guardado dónde
    estabas. Sin esto, ahí seguiría el parpadeo.
    =========================================================================== %>
<script>
  (() => {
    try {
      const url = new URLSearchParams(location.search);
      // Si la URL ya lo dice, el servidor ya lo ha pintado: nada que hacer.
      if (url.get('p') && url.get('sp')) return;

      const guardado = JSON.parse(
        sessionStorage.getItem('etapa:<%= etapa.id %>:vista') ?? '{}'
      ) ?? {};

      const activar = (botones, paneles, clave, claseActiva, elegido) => {
        const i = botones.findIndex((b) => b.dataset[clave] === elegido);
        if (i <= 0) return;   // 0 ya está puesta, y -1 es que no la conocemos
        botones.forEach((b, n) => {
          b.classList.toggle(claseActiva, n === i);
          b.setAttribute('aria-selected', String(n === i));
        });
        paneles.forEach((pa, n) => { if (pa) pa.hidden = n !== i; });
      };

      if (!url.get('p') && guardado.pestana) {
        const botones = [...document.querySelectorAll('#pestanas .pestana')];
        activar(botones, botones.map((b) => document.getElementById(b.dataset.panel)),
                'ancla', 'pestana--activa', guardado.pestana);
      }

      if (!url.get('sp') && guardado.subpestana) {
        const botones = [...document.querySelectorAll('.subpestanas .subpestana')];
        activar(botones, botones.map((b) => document.getElementById(b.dataset.subpanel)),
                'subpanel', 'subpestana--activa', guardado.subpestana);
      }
    } catch { /* sin sessionStorage: se queda la de por defecto y ya está */ }
  })();
</script>

