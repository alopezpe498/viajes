<%
/**
 * EL PROGRESO DEL VIAJE AUTOMÁTICO.
 *
 * Seis fases en orden, cada una con su estado, lo que ha ido haciendo y lo que
 * no ha conseguido. Se refresca sola con el mismo mecanismo de sondeo que el
 * resto de la aplicación: mientras algo trabaje, se pregunta; cuando no queda
 * nada en marcha, se para sola.
 *
 * SI CIERRAS ESTA PANTALLA NO PASA NADA. El trabajo va por la cola, en segundo
 * plano, y sigue. Al volver al viaje se te enseña por dónde va.
 *
 * Espera: viaje, progreso.
 */
const cabezaExtra = '<link rel="stylesheet" href="/css/orquestador.css">';
const pieExtra = '<script src="/js/orquestador.js" defer></script>';

const ICONO_ESTADO = {
  pendiente: 'ti-circle',
  en_curso: 'ti-loader-2',
  hecho: 'ti-circle-check',
  con_huecos: 'ti-alert-circle',
  error: 'ti-circle-x',
};

/**
 * Cuándo se escribió una pasada, en corto. Las horas vienen de SQLite en UTC.
 */
const cuandoCorto = (iso) => {
  if (!iso) return '';
  const d = new Date(String(iso).replace(' ', 'T') + 'Z');
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleString('es-ES', {
    day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
  });
};
%>
<%- include('parciales/cabecera', {
      viaje: null,
      pasoActual: null,
      // El título de la pestaña dice en qué punto va: con varias pestañas
      // abiertas es lo único que se ve del progreso sin volver a mirar.
      titulo: `${progreso.terminado ? 'Montado' : 'Montando'} · ${viaje.nombre}`,
      extraCabeza: cabezaExtra,
    }) %>

<main class="envoltorio envoltorio--simple">
  <div class="contenido orquestador" data-viaje="<%= viaje.id %>"
       data-trabajando="<%= progreso.trabajando ? '1' : '' %>">

    <header class="ruta-cabecera">
      <p class="ruta-cabecera__miga">
        <a href="/">Mis viajes</a> / <%= viaje.nombre %>
      </p>
      <h1 class="orq__titulo">
        <i class="ti ti-sparkles" aria-hidden="true"></i>
        <%= progreso.terminado ? 'Tu viaje está montado' : 'Montando tu viaje' %>
      </h1>
      <p class="orq__bajada" id="orq-bajada">
        <% if (progreso.trabajando) { %>
          Voy por la fase <%= Math.min(progreso.resueltas + 1, progreso.total) %> de <%= progreso.total %>.
          Puedes cerrar esta pantalla: sigue en segundo plano.
        <% } else if (progreso.terminado) { %>
          Ya está. Aquí queda todo lo que decidió y por qué; puedes volver cuando
          quieras desde «Cómo se montó este viaje».
        <% } else { %>
          Todavía no ha empezado.
        <% } %>
      </p>
    </header>

    <%# ===================== PARAR ESTO =====================
        Dos botones y muy distintos a la vista, porque hacen cosas muy
        distintas. El normal espera a que termine el paso que hay en marcha y no
        deja nada a medias; el rojo corta en seco y después hay que barrer.

        Solo salen mientras haya algo corriendo: un botón de parar en una
        pantalla parada no para nada y solo confunde. %>
    <div class="orq-parada" id="orq-parada" <%= progreso.trabajando ? '' : 'hidden' %>>
      <button class="boton boton--secundario" type="button" id="orq-parar">
        <i class="ti ti-player-pause" aria-hidden="true"></i> Parar
      </button>
      <button class="boton boton--peligro" type="button" id="orq-abortar">
        <i class="ti ti-hand-stop" aria-hidden="true"></i> Abortar ya
      </button>
      <span class="orq-parada__nota" id="orq-parada-nota">
        <% if (progreso.parando === 'limpia') { %>
          Parando en cuanto termine el paso que tiene entre manos…
        <% } else if (progreso.parando === 'abortar') { %>
          Abortando y limpiando lo que quedó a medias…
        <% } else { %>
          «Parar» acaba el paso en marcha y lo deja ahí. «Abortar ya» corta en seco.
        <% } %>
      </span>
    </div>

    <%# La barra: cuántas fases están resueltas, con hueco o sin él. %>
    <div class="orq-barra" role="progressbar" aria-valuemin="0" aria-valuemax="100"
         aria-valuenow="<%= progreso.porcentaje %>" aria-label="Progreso del montaje">
      <div class="orq-barra__relleno" id="orq-relleno" style="width: <%= progreso.porcentaje %>%"></div>
    </div>

    <ol class="orq-fases" id="orq-fases">
      <% progreso.fases.forEach(f => { %>
        <li class="orq-fase orq-fase--<%= f.estado %>" data-fase="<%= f.clave %>">
          <div class="orq-fase__marca">
            <i class="ti <%= ICONO_ESTADO[f.estado] %> <%= f.estado === 'en_curso' ? 'orq-gira' : '' %>"
               aria-hidden="true"></i>
          </div>

          <div class="orq-fase__cuerpo">
            <div class="orq-fase__cabecera">
              <h2 class="orq-fase__nombre">
                <i class="ti <%= f.icono %>" aria-hidden="true"></i> <%= f.etiqueta %>
              </h2>
              <span class="orq-fase__estado"><%= f.nombreEstado %></span>
            </div>

            <p class="orq-fase__explica"><%= f.explica %></p>

            <%# EL REGISTRO DE LA ÚLTIMA PASADA.
                Cada línea con un dato concreto lleva su etiqueta de origen al
                final. Un [IA] en una línea con un precio o un horario es una
                alarma: ese número no lo ha traído nadie de fuera. %>
            <% if (f.lineas.length) { %>
              <ol class="orq-log">
                <% f.lineas.forEach(l => { %>
                  <li class="orq-log__linea"><%= l.texto %><%
                    if (l.origen) { %><span class="orq-origen orq-origen--<%= l.origen %>"
                      title="De dónde sale el dato de esta línea"><%= l.nombreOrigen %></span><% }
                  %></li>
                <% }) %>
              </ol>
            <% } %>

            <%# LAS VECES ANTERIORES. Relanzar una fase ya no borra lo que dijo
                la vez pasada: se pliega aquí, con su fecha, para poder comparar. %>
            <% f.anteriores.forEach(v => { %>
              <details class="orq-pasada">
                <summary>
                  <i class="ti ti-history" aria-hidden="true"></i>
                  Pasada <%= v.pasada %><%= v.cuando ? ` · ${cuandoCorto(v.cuando)}` : '' %>
                  (<%= v.lineas.length %> línea<%= v.lineas.length === 1 ? '' : 's' %>)
                </summary>
                <ol class="orq-log orq-log--vieja">
                  <% v.lineas.forEach(l => { %>
                    <li class="orq-log__linea"><%= l.texto %><%
                      if (l.origen) { %><span class="orq-origen orq-origen--<%= l.origen %>"><%= l.nombreOrigen %></span><% }
                    %></li>
                  <% }) %>
                </ol>
              </details>
            <% }) %>

            <% if (f.huecos.length) { %>
              <ul class="orq-fase__huecos">
                <% f.huecos.forEach(h => { %>
                  <li><i class="ti ti-alert-triangle" aria-hidden="true"></i> <%= h %></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ol>

    <% if (progreso.mensajeError) { %>
      <p class="orq-fallo">
        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
        El montaje se cortó: <%= progreso.mensajeError %>
      </p>
    <% } %>

    <%# LOS HUECOS, TODOS JUNTOS. Es lo que hay que repasar a mano, y leerlo
        fase por fase no da la foto: aquí está la lista entera. %>
    <% if (progreso.huecos.length) { %>
      <section class="orq-resumen-huecos">
        <h2><i class="ti ti-list-check" aria-hidden="true"></i> Lo que te dejo para repasar</h2>
        <ul>
          <% progreso.huecos.forEach(h => { %>
            <li><strong><%= h.fase %>:</strong> <%= h.texto %></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <%# REANUDAR: sale cuando el montaje esta parado a medias, que es justo lo
        que deja una parada. No rehace lo hecho: sigue por la primera pendiente. %>
    <% if (!progreso.trabajando && progreso.empezado && !progreso.terminado) { %>
      <div class="orq-parada">
        <button class="boton boton--primario" type="button" id="orq-reanudar">
          <i class="ti ti-player-play" aria-hidden="true"></i> Reanudar donde se quedó
        </button>
        <span class="orq-parada__nota" id="orq-reanudar-nota">
          Las fases ya hechas no se repiten.
        </span>
      </div>
    <% } %>

    <div class="orq-pie">
      <a class="boton <%= progreso.terminado ? 'boton--primario' : 'boton--secundario' %>"
         href="/viaje/<%= viaje.id %>/ruta" id="orq-ver-ruta">
        <i class="ti ti-route" aria-hidden="true"></i> Ver mi ruta
      </a>
      <a class="boton boton--secundario" href="/viajes/<%= viaje.id %>/paso/1">
        <i class="ti ti-adjustments-horizontal" aria-hidden="true"></i> Volver a la configuración
      </a>
    </div>
  </div>
</main>

<%- include('parciales/pie', { extraPie: pieExtra }) %>
