<%
/**
 * MI RUTA: las paradas del viaje, en orden.
 *
 * El servidor pinta la primera vez y el JS repinta después de cada cambio, con
 * el mismo objeto que devuelven los endpoints. Por eso el marcado de aquí y el
 * de public/js/ruta.js tienen que decir lo mismo: si tocas uno, toca el otro.
 *
 * Espera: ruta (lo que devuelve rutaDeViaje()).
 *
 * La maqueta usaba emoji para los iconos (🏠 ⠿ ⚠ ✓). Aquí van los de Tabler,
 * que es lo que usa el resto de la app.
 */
const pieExtra =
  '<script src="/js/ruta.js"></script>' +
  '<script src="/js/dosier.js"></script>' +
  '<script src="/js/antes-de-viajar.js"></script>';

/** 330 -> "5 h 30". El mismo formato que usan los tramos. */
const comoDuracion = (m) => {
  const h = Math.floor(m / 60);
  const min = m % 60;
  if (!h) return `${min} min`;
  return min ? `${h} h ${String(min).padStart(2, '0')}` : `${h} h`;
};
const { viaje } = ruta;
%>
<%- include('parciales/cabecera', {
      viaje: null,
      pasoActual: null,
      titulo: `Mi ruta · ${viaje.nombre}`,
      extraCabeza: ''
    }) %>

<main class="envoltorio envoltorio--simple">
  <div class="contenido contenido--ruta" data-viaje="<%= viaje.id %>">

    <%# ---------------------- Cabecera ---------------------- %>
    <header class="ruta-cabecera">
      <p class="ruta-cabecera__miga">
        <a href="/">Mis viajes</a> / <a href="/viajes/<%= viaje.id %>"><%= viaje.nombre %></a>
      </p>
      <div class="etapa-titular">
        <h1 class="ruta-cabecera__titulo">
          Mi ruta
          <% if (viaje.ambito) { %><span class="chip-ambito"><%= viaje.ambito %></span><% } %>
        </h1>

        <span class="etapa-acciones">
          <%# El dosier, en una línea. El mismo control que en el lienzo: el
              viaje se cierra desde donde se esté mirando. %>
          <%- include('parciales/panel-dosier', { viajeId: viaje.id, dosier }) %>

          <%# Volver al mapa a por más ciudades. Solo sale si el destino del
              viaje es un país o una región: en un viaje a Sevilla no hay nada
              más que explorar allí, y el botón sería una puerta a ninguna parte. %>
          <% if (typeof urlExplorar !== 'undefined' && urlExplorar) { %>
            <a class="boton-discreto" href="<%= urlExplorar %>">
              <i class="ti ti-compass" aria-hidden="true"></i> Elegir más ciudades
            </a>
          <% } %>

          <%# Entrar al viaje ya no pasa por el configurador, así que las fechas y
              los viajeros se cambian desde aquí. %>
          <a class="boton-discreto" href="/viajes/<%= viaje.id %>/paso/1?volverA=/viaje/<%= viaje.id %>/ruta">
            <i class="ti ti-adjustments-horizontal" aria-hidden="true"></i> Configuración
          </a>
        </span>
      </div>
    </header>

    <%# ---------------------- Antes de viajar ----------------------
        SIEMPRE VISIBLE, y con cara de aviso.
        Esto no es una pantalla más a la que se llega si uno se acuerda: es lo
        que hay que mirar semanas antes de salir, cuando todavía da tiempo a
        pedir un visado o a ponerse una vacuna. Un enlace discreto en un menú
        se descubre el día de antes, que es cuando ya no sirve. %>
    <button class="antes-boton <%= antesRevisado ? 'antes-boton--hecho' : '' %>"
            type="button" id="abrir-antes" data-revisado="<%= antesRevisado ? '1' : '' %>">
      <i class="ti <%= antesRevisado ? 'ti-check' : 'ti-alert-triangle' %> antes-boton__icono"
         aria-hidden="true"></i>
      <span class="antes-boton__texto">
        <strong>Antes de viajar</strong>
        <span class="antes-boton__pie">
          <%= antesRevisado
                ? 'Revisado. Puedes volver a mirarlo cuando quieras.'
                : 'Papeles, vacunas, dinero y festivos de cada país' %>
        </span>
      </span>
      <i class="ti ti-chevron-right antes-boton__flecha" aria-hidden="true"></i>
    </button>

    <%# ---------------------- Contador de noches ----------------------
        Lo pinta el JS, para que después de cada cambio no haya dos sitios
        distintos donde tocar el mismo número. %>
    <section class="ruta-contador" id="ruta-contador"></section>

    <%# ---------------------- Candidatos ---------------------- %>
    <h2 class="seccion-titulo">
      Candidatos <span class="seccion-titulo__num" id="num-candidatos">0</span>
    </h2>
    <div class="candidatos" id="zona-candidatos"></div>

    <%# ---------------------- Ruta confirmada ---------------------- %>
    <h2 class="seccion-titulo">
      Ruta confirmada <span class="seccion-titulo__num" id="num-etapas">0</span>
    </h2>
    <div class="ruta-lista" id="zona-ruta"></div>

    <%# ---------------------- Traslados ----------------------
        Cuánta carretera hay DENTRO del viaje. La ida y la vuelta a casa no
        cuentan: son vuelos, y sumarlos convertiría cualquier viaje a Italia en
        "4.000 km de coche". %>
    <% if (traslados.saltos.length) { %>
      <p class="ruta-traslados">
        <i class="ti ti-car" aria-hidden="true"></i>
        <span class="ruta-traslados__total">
          Total traslados: <%= traslados.km.toLocaleString('es-ES') %> km<%
            if (traslados.minutos) { %> · <%= comoDuracion(traslados.minutos) %> en coche<% }
          %>
        </span>
        <% if (traslados.incompletos) { %>
          <span class="ruta-traslados__falta">
            (<%= traslados.incompletos %> <%= traslados.incompletos === 1 ? 'tramo' : 'tramos' %> sin calcular)
          </span>
        <% } %>
      </p>

      <% if (avisoTraslados) { %>
        <p class="ruta-traslados__aviso">
          <i class="ti ti-alert-triangle" aria-hidden="true"></i>
          <%= avisoTraslados.texto %> — <%= avisoTraslados.horas %> h de carretera.
        </p>
      <% } %>
    <% } %>

    <%# ---------------------- Pie ---------------------- %>
    <div class="ruta-pie">
      <a class="boton-lienzo" href="/viaje/<%= viaje.id %>/lienzo">
        <i class="ti ti-layout-board" aria-hidden="true"></i> Ver el lienzo del viaje
      </a>
    </div>
  </div>
</main>

<%# ---------------------- Panel "Antes de viajar" ----------------------
    Se llama `antes-*` y no `modal-*` a propósito: en esta misma pantalla ya
    hay un `.modal` (el de confirmar el borrado de una parada) y reutilizar el
    nombre hace que las dos se pisen las reglas. Ya pasó una vez.

    Nace vacío: lo rellena public/js/antes-de-viajar.js con lo que conteste el
    servidor, y así no hay dos sitios pintando lo mismo. %>
<div class="antes-fondo" id="antes-fondo" hidden>
  <div class="antes" role="dialog" aria-modal="true" aria-labelledby="antes-titulo">
    <header class="antes__cabecera">
      <div>
        <h2 class="antes__titulo" id="antes-titulo">
          <i class="ti ti-alert-triangle" aria-hidden="true"></i> Antes de viajar
        </h2>
        <p class="antes__rango" id="antes-rango"></p>
      </div>
      <button class="antes__cerrar" type="button" data-antes-cerrar aria-label="Cerrar">
        <i class="ti ti-x" aria-hidden="true"></i>
      </button>
    </header>

    <div class="antes__paises" id="antes-paises" role="tablist" aria-label="Países del viaje"></div>
    <div class="antes__cuerpo" id="antes-cuerpo"></div>

    <%# YA LO HE REVISADO.
        Va al pie del panel y no dentro de la pestaña de un país, porque lo que
        se revisa es el viaje entero: si son dos países, se han mirado los dos. %>
    <footer class="antes__revisado">
      <label class="antes-check">
        <input type="checkbox" id="antes-revisado" <%= antesRevisado ? 'checked' : '' %>>
        <span class="antes-check__marca" aria-hidden="true"><i class="ti ti-check"></i></span>
        <span class="antes-check__texto">
          <strong>Ya lo he revisado</strong>
          <span class="antes-check__pie" id="antes-revisado-pie"></span>
        </span>
      </label>
    </footer>
  </div>
</div>

<%# ---------------------- Modal de confirmación ----------------------
    El de la app, no el confirm() del navegador: aquí se está borrando una
    parada de una ruta que ha costado montar y merece una pregunta con cara. %>
<div class="modal" id="modal" hidden>
  <div class="modal__fondo" data-modal-cerrar></div>
  <div class="modal__caja" role="dialog" aria-modal="true" aria-labelledby="modal-titulo">
    <h2 class="modal__titulo" id="modal-titulo">¿Quitar esta parada?</h2>
    <p class="modal__texto" id="modal-texto"></p>
    <div class="modal__botones">
      <button class="boton boton--secundario" type="button" data-modal-cerrar>Cancelar</button>
      <button class="boton boton--peligro" type="button" id="modal-confirmar">
        <i class="ti ti-trash" aria-hidden="true"></i> Quitar
      </button>
    </div>
  </div>
</div>

<%# Los datos de partida viajan en el HTML: la pantalla se pinta ya llena, sin
    una petición extra nada más cargar. %>
<script type="application/json" id="datos-ruta"><%- JSON.stringify(ruta) %></script>

<%- include('parciales/pie', { extraPie: pieExtra }) %>
