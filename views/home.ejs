<%
/**
 * PORTADA: el cuaderno de viajes.
 *
 * Panel de acento a la izquierda y los viajes como billetes a la derecha, sobre
 * un fondo de carta náutica. El SVG del fondo es decorativo y no recibe clics.
 *
 * Espera: billetes, total, proximaSalida.
 */
const pieExtra = '<script src="/js/home.js"></script>';

// Los estilos de la portada van en su PROPIA hoja, que solo carga esta pantalla.
// Sus nombres son genéricos (`panel`, `principal`, `menu`, `billete`) y en la
// hoja compartida se llevaron por delante la ficha de lugar y la de etapa, que
// también tienen algo llamado `panel`. Aislada por fichero, no puede pasar.
const cabezaExtra = '<link rel="stylesheet" href="/css/portada.css">';
%>
<%- include('parciales/cabecera', {
      viaje: null, pasoActual: null, titulo: 'Viajes Toni', extraCabeza: cabezaExtra
    }) %>

<div class="portada">

  <%# ======================= PANEL LATERAL ======================= %>
  <aside class="panel">
    <span class="panel__sello" aria-hidden="true"><i class="ti ti-plane"></i></span>

    <h1 class="panel__titulo">Viajes<br><span>Toni</span></h1>
    <p class="panel__lema">
      Explora, apunta, reparte los días. El viaje empieza mucho antes de salir de casa.
    </p>

    <form method="POST" action="/viajes">
      <button class="panel__nuevo" type="submit">
        <i class="ti ti-plus" aria-hidden="true"></i> Nuevo viaje
      </button>
    </form>

    <%# Trazo de ruta decorativo. %>
    <svg class="panel__ruta" viewBox="0 0 220 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10,140 C60,60 120,150 210,30" stroke="white" stroke-width="2.5" fill="none"
            stroke-dasharray="1 9" stroke-linecap="round"/>
      <circle cx="10" cy="140" r="5" fill="white"/>
      <path d="M210,30 l-4,12 l-8,-9 Z" fill="white"/>
    </svg>

    <p class="panel__dato">
      <%= total %> <%= total === 1 ? 'viaje' : 'viajes' %> en el cuaderno
      <% if (proximaSalida) { %><br>Próxima salida: <%= proximaSalida %><% } %>
    </p>
  </aside>

  <%# ======================= LOS BILLETES ======================= %>
  <main class="principal">

    <%# Fondo de carta náutica: curvas de nivel, cruces, rosa y ruta. Decorativo. %>
    <svg class="fondo-mapa" viewBox="0 0 1000 760" preserveAspectRatio="xMidYMid slice"
         xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
      <g stroke="#5E7A87" stroke-width="1.3" opacity="0.14">
        <path d="M640,-40 C560,60 590,150 700,190 C820,232 940,190 1010,120"/>
        <path d="M700,-40 C640,50 670,130 760,163 C860,198 960,160 1015,105"/>
        <path d="M760,-40 C716,40 745,110 815,138 C895,169 975,135 1020,88"/>
        <path d="M820,-40 C790,30 815,90 870,113 C930,138 990,110 1025,72"/>
        <path d="M880,-30 C862,20 882,68 925,88 C965,106 1005,85 1030,55"/>
        <path d="M930,-15 C920,15 935,50 968,65 C995,77 1020,62 1035,40"/>
      </g>
      <g stroke="#5E7A87" stroke-width="1.3" opacity="0.14">
        <path d="M-40,470 C80,430 200,470 240,560 C280,650 220,740 120,790"/>
        <path d="M-40,520 C60,488 160,520 195,590 C230,660 185,730 105,772"/>
        <path d="M-40,570 C40,545 120,570 148,622 C176,674 145,725 85,757"/>
        <path d="M-40,620 C25,602 82,620 103,656 C124,692 102,728 60,750"/>
        <path d="M-35,668 C10,655 48,667 62,690 C76,713 62,736 33,750"/>
      </g>
      <g stroke="#5E7A87" stroke-width="1.4" opacity="0.16">
        <path d="M330,120 h14 M337,113 v14"/>
        <path d="M560,90 h14 M567,83 v14"/>
        <path d="M460,300 h14 M467,293 v14"/>
        <path d="M690,340 h14 M697,333 v14"/>
        <path d="M350,480 h14 M357,473 v14"/>
        <path d="M580,540 h14 M587,533 v14"/>
        <path d="M820,520 h14 M827,513 v14"/>
        <path d="M480,680 h14 M487,673 v14"/>
        <path d="M740,680 h14 M747,673 v14"/>
        <path d="M240,280 h14 M247,273 v14"/>
      </g>
      <g transform="translate(845,625)" stroke="#5E7A87" opacity="0.20">
        <circle r="54" stroke-width="1.2"/>
        <circle r="44" stroke-width="1" stroke-dasharray="1 5"/>
        <path d="M0,-54 L7,-9 L0,0 L-7,-9 Z" fill="#5E7A87" stroke="none" opacity="0.8"/>
        <path d="M0,54 L7,9 L0,0 L-7,9 Z M-54,0 L-9,-7 L0,0 L-9,7 Z M54,0 L9,-7 L0,0 L9,7 Z" stroke-width="1.2"/>
        <path d="M-32,-32 L0,0 M32,-32 L0,0 M-32,32 L0,0 M32,32 L0,0" stroke-width="0.9"/>
        <text y="-62" text-anchor="middle" font-family="Georgia, serif" font-size="13" fill="#5E7A87" stroke="none">N</text>
      </g>
      <g opacity="0.20">
        <path d="M180,700 C320,600 300,430 470,390 C640,350 700,240 880,180" stroke="#1B7FA6"
              stroke-width="1.6" stroke-dasharray="6 7" stroke-linecap="round"/>
        <circle cx="180" cy="700" r="5" fill="#1B7FA6"/>
        <circle cx="470" cy="390" r="5" fill="none" stroke="#1B7FA6" stroke-width="1.6"/>
        <circle cx="880" cy="180" r="5" fill="none" stroke="#1B7FA6" stroke-width="1.6"/>
      </g>
    </svg>

    <h2 class="principal__titulo">Mis viajes</h2>

    <div class="billetes">
      <% billetes.forEach(b => { %>
        <article class="billete" data-viaje="<%= b.id %>" data-nombre="<%= b.nombre %>">
          <a class="billete__enlace" href="/viajes/<%= b.id %>" aria-label="Abrir <%= b.nombre %>"></a>

          <div class="talon">
            <% if (b.talon) { %>
              <span class="talon__mes"><%= b.talon.mes %></span>
              <span class="talon__dia"><%= b.talon.dia %></span>
            <% } else { %>
              <span class="talon__sin" title="Sin fechas todavía">?</span>
            <% } %>
          </div>

          <div class="billete__cuerpo">
            <h3 class="billete__nombre"><%= b.nombre %></h3>

            <p class="billete__ciudades">
              <% if (b.ciudades.length) { %>
                <% b.ciudades.forEach((c, i) => { %>
                  <% if (i) { %><span class="billete__flecha" aria-hidden="true">→</span><% } %><%= c %>
                <% }) %>
              <% } else { %>
                <span class="secundario">Sin ruta todavía</span>
              <% } %>
            </p>

            <div class="billete__chips">
              <% if (b.etapas) { %>
                <span class="chip-billete chip-billete--etapas">
                  <%= b.etapas %> <%= b.etapas === 1 ? 'etapa' : 'etapas' %><%
                    if (b.nochesRepartidas) { %> · <%= b.nochesRepartidas %> <%= b.nochesRepartidas === 1 ? 'noche' : 'noches' %><% }
                  %>
                </span>
              <% } %>

              <% if (b.estado === 'cuadra') { %>
                <span class="chip-billete chip-billete--cuadra">
                  <i class="ti ti-check" aria-hidden="true"></i> Cuadra
                </span>
              <% } else if (b.estado === 'faltan') { %>
                <span class="chip-billete chip-billete--faltan">
                  <% if (b.sobran) { %>
                    Sobran <%= b.sobran %> <%= b.sobran === 1 ? 'noche' : 'noches' %>
                  <% } else { %>
                    Faltan <%= b.faltan %> <%= b.faltan === 1 ? 'noche' : 'noches' %>
                  <% } %>
                </span>
              <% } %>
            </div>
          </div>

          <%# El menú va por encima del enlace que cubre el billete. %>
          <button class="menu-btn" type="button" aria-label="Opciones de <%= b.nombre %>"
                  aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-dots" aria-hidden="true"></i>
          </button>
          <div class="menu" role="menu">
            <button type="button" role="menuitem" data-renombrar="<%= b.id %>">Cambiar nombre</button>
            <button type="button" role="menuitem" class="menu__peligro" data-borrar="<%= b.id %>">
              Borrar viaje…
            </button>
          </div>
        </article>
      <% }) %>

      <form method="POST" action="/viajes" class="billete-nuevo-form">
        <button class="billete-nuevo" type="submit">
          <i class="ti ti-plus" aria-hidden="true"></i> Empezar un viaje nuevo
        </button>
      </form>
    </div>
  </main>
</div>

<%# ---------------------- Modal de borrado ---------------------- %>
<div class="modal" id="modal-borrar" hidden>
  <div class="modal__fondo" data-modal-cerrar></div>
  <div class="modal__caja" role="dialog" aria-modal="true" aria-labelledby="borrar-titulo">
    <h2 class="modal__titulo" id="borrar-titulo">¿Borrar este viaje?</h2>
    <p class="modal__texto" id="borrar-texto"></p>

    <%# Lo que se limpia del catálogo, cuando lo hay. Lo rellena home.js: solo
        se enseña si de verdad hay ciudades que se quedan sin nadie. %>
    <p class="modal__texto modal__texto--nota" id="borrar-catalogo" hidden></p>

    <%# ESCRIBIR EL NOMBRE PARA CONFIRMAR.
        Esto ya no se puede deshacer y ahora se lleva más por delante que
        antes: un botón rojo a un clic de distancia es poca ceremonia para
        eso. Teclear el nombre obliga a mirar cuál es el viaje. %>
    <label class="modal__etiqueta" for="borrar-nombre">
      Escribe <strong id="borrar-nombre-eco"></strong> para confirmar
    </label>
    <input class="modal__campo" type="text" id="borrar-nombre" autocomplete="off"
           spellcheck="false" placeholder="Nombre del viaje">

    <div class="modal__botones">
      <button class="boton boton--secundario" type="button" data-modal-cerrar>Cancelar</button>
      <button class="boton boton--peligro" type="button" id="borrar-confirmar" disabled>
        <i class="ti ti-trash" aria-hidden="true"></i> Borrar
      </button>
    </div>
  </div>
</div>

<%# ---------------------- Modal de renombrar ---------------------- %>
<div class="modal" id="modal-nombre" hidden>
  <div class="modal__fondo" data-modal-cerrar></div>
  <form class="modal__caja" role="dialog" aria-modal="true" aria-labelledby="nombre-titulo" id="form-nombre">
    <h2 class="modal__titulo" id="nombre-titulo">Cambiar nombre</h2>
    <input class="modal__campo" type="text" name="nombre" maxlength="120" autocomplete="off"
           aria-label="Nombre del viaje">
    <div class="modal__botones">
      <button class="boton boton--secundario" type="button" data-modal-cerrar>Cancelar</button>
      <button class="boton boton--primario" type="submit">Guardar</button>
    </div>
  </form>
</div>

<%- include('parciales/pie', { extraPie: pieExtra }) %>
