<%
/**
 * TRASLADOS: la chuleta de "cuánto hay de aquí a allá".
 *
 * DOS LISTAS, NO UNA. La de consultas crecía sin freno: cada vez que uno mira
 * cuánto hay de un sitio a otro se queda una línea, y a la décima ya no se
 * encuentra la que de verdad importa —"del hotel al centro"— entre las nueve
 * que se miraron una vez y no volvieron a hacer falta.
 *
 * Arriba, las FIJADAS: las que he decidido tener a mano. Abajo, plegado, el
 * HISTORIAL. No se borra nada; una consulta hecha puede volver a hacer falta, y
 * además ya está pagada en tiempo de cálculo.
 *
 * Espera: traslados ({ fijados, historial }), lugares, etapa, viaje,
 *         diasDeLaEtapa.
 */
%>
<section class="traslados" data-traslados-de="<%= etapa.id %>">

  <div class="seccion-cabecera">
    <h3 class="seccion-cabecera__titulo">
      <i class="ti ti-route" aria-hidden="true"></i> Traslados
    </h3>
    <p class="seccion-cabecera__pie">
      ¿Cuánto hay de aquí a allá? Lo que consultes se queda apuntado.
    </p>
  </div>

  <%# --- El buscador ------------------------------------------------------ %>
  <form class="traslados__buscador" id="buscador-traslado" data-etapa="<%= etapa.id %>">
    <%# Los dos campos usan la MISMA lista: de cualquier sitio se puede ir a
        cualquier sitio, y duplicarla sería tener que acordarse dos veces. %>
    <datalist id="lugares-<%= etapa.id %>">
      <% lugares.filter(l => l.situada).forEach(l => { %>
        <option value="<%= l.nombre %>"><%= l.etiqueta %><% if (l.direccion) { %> · <%= l.direccion %><% } %></option>
      <% }) %>
    </datalist>

    <label class="traslados__campo">
      <span>Desde</span>
      <input type="text" name="origen" list="lugares-<%= etapa.id %>" autocomplete="off"
             placeholder="Hotel, un sitio, o escribe una dirección" required>
    </label>

    <span class="traslados__flecha" aria-hidden="true"><i class="ti ti-arrow-right"></i></span>

    <label class="traslados__campo">
      <span>Hasta</span>
      <input type="text" name="destino" list="lugares-<%= etapa.id %>" autocomplete="off"
             placeholder="Hotel, un sitio, o escribe una dirección" required>
    </label>

    <button class="boton boton--primario" type="submit">
      <i class="ti ti-calculator" aria-hidden="true"></i> Calcular
    </button>
  </form>

  <%# Los que todavía no se pueden usar, dichos una vez y sin dramatismo: es
      más útil saber por qué no salen en la lista que no verlos y no saber. %>
  <% const sinSituar = lugares.filter(l => !l.situada); %>
  <% if (sinSituar.length) { %>
    <p class="traslados__pendientes secundario">
      <i class="ti ti-map-pin-off" aria-hidden="true"></i>
      Sin dirección todavía: <%= sinSituar.slice(0, 4).map(l => l.nombre).join(', ') %><%
        if (sinSituar.length > 4) { %> y <%= sinSituar.length - 4 %> más<% } %>.
      Pónsela en su ficha y aparecerán aquí.
    </p>
  <% } %>

  <div class="traslados__error aviso aviso--alerta" id="traslado-error" hidden>
    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
    <div>
      <p class="aviso__texto" data-mensaje></p>
      <button class="boton boton--secundario boton--pequeno" type="button" data-ir-a-direccion hidden>
        Poner esa dirección
      </button>
    </div>
  </div>

  <%# --- Los fijados, arriba y a la vista --------------------------------- %>
  <% if (traslados.fijados.length) { %>
    <ul class="traslados__lista">
      <% traslados.fijados.forEach(t => { %>
        <%- include('traslado', { t, diasDeLaEtapa }) %>
      <% }) %>
    </ul>
  <% } %>

  <%# --- Y el historial, plegado ------------------------------------------ %>
  <% if (traslados.historial.length) { %>
    <details class="traslados__historial" <%= traslados.fijados.length ? '' : 'open' %>>
      <summary>
        <i class="ti ti-history" aria-hidden="true"></i>
        Consultas anteriores <span class="pastilla"><%= traslados.historial.length %></span>
      </summary>
      <ul class="traslados__lista">
        <% traslados.historial.forEach(t => { %>
          <%- include('traslado', { t, diasDeLaEtapa }) %>
        <% }) %>
      </ul>
    </details>
  <% } %>

  <% if (!traslados.fijados.length && !traslados.historial.length) { %>
    <p class="candidatos__vacio">
      Todavía no has consultado ningún traslado en <%= etapa.nombre_ciudad %>.
    </p>
  <% } %>
</section>
